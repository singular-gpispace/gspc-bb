		<transition name="update_Q" priority="4">
			<defun>
				<require key="update_Q" mandatory="true"/>
				<in name="nT_started_indices" type="unsigned long"/>
				<in name="nworkers" type="int"/>
				<in name="base_filename" type="string"/>
				<in name="installdir" type="string"/>
				<in name="degBounds" type="list"/>
				<!--in name="Q_in" type="list"/-->
				<in name="NF_list_input" type="map"/>
				<in name="r_in" type="int"/>
				<in name="Qback" type="index_pair"/>
				<in name="blacklist" type="set"/>
				<in name="enable_update_Q" type="control"/>
				<inout name="nrunning" type="int"/>
				<inout name="M" type="list"/>
				<out name="update_Qback_r" type="list"/>
				<out name="update_job_queue" type="list"/>
				<out name="paused_indices" type="list"/>
				<out name="runtime" type="map"/>
				<out name="enable_get_NF_list" type="control"/>
				<out name="BB_finished" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_update_Q(paused_indices, NF_list_input, enable_get_NF_list, installdir, degBounds, runtime, base_filename, Qback, r_in, update_Qback_r, M, BB_finished, blacklist, nT_started_indices, nrunning, nworkers, update_job_queue)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="fstream"/>
					<cinclude href="chrono"/>
					<cinclude href="thread"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
					//SLEEP_MS(100);

					long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
					std::string singular_function_name = "update_Q";

					int r = r_in;
					GpiSet add_to_blacklist = {};

					/*
						long deserialize_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						GpiList output;

						std::vector<boost::variant<long,std::string,GpiList>>  args_read, args_in;  std::vector<boost::variant<long*,std::string*,GpiList*>>  args_inout, out;  std::vector<GpiList*>  out_many;
						std::string singular_function_name = "deserialize";
						//std::string library_name = base_filename.substr(0, base_filename.find_last_of('/', base_filename.size() - 2) + 1) + "buchbergergp.lib";
						std::string library_name = installdir + "buchbergergp.lib";
						args_read  = {Q_in};
						args_in    = {};
						args_inout = {};
						out        = {&output};
						out_many   = {};
						bool delete_files = false;
						bool silent = true;
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute) (library_name, singular_function_name, base_filename+"intermediate_files/", args_read, args_in, args_inout, out, out_many, delete_files, silent);

						long deserialize_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "deserialize in update_Q"] = GpiList({-1L, deserialize_stop, deserialize_stop-deserialize_start, 1L});

						static GpiList Q = output;
					*/

					//static GpiList Q = Q_in; //!!
					//static std::pair<sPairQueue,sPairQueue_by_indices> Q_Qind = deserialize_queue(base_filename+"queue/Q");
					static sPairQueue                Q = deserialize_queue(base_filename+"queue/Q");
					//static sPairQueue_by_indices  Qind = Q_Qind.second;
/*
					//print_variant(*Q.begin());
					if (Qind.find(std::make_pair((int) 11, (int) 13))!=Qind.end())
					{
						std::cout << "true " << std::endl;
						std::cout << " TEST: ("<<11<<","<<13<<")" << " == " << "("<< boost::get<int>((*Qind[std::make_pair((int) 11, (int) 13)]).front()) <<","<< boost::get<int>(*std::next((*Qind[std::make_pair((int) 11, (int) 13)]).begin())) <<")" << "\n\n";
						print_variant(*Qind[std::make_pair(11,13)]);
					}
					else
						std::cout << "false" << std::endl;
*/
					//fix_Q(Q,Qind,&nrunning);

					#ifdef DEBUG_BBA
					std::cout << runtime_start << ": ENTERING UPDATE_Q:  Q.size()="<<Q.size()<<", nT_started_indices="<<nT_started_indices<<", nworkers="<<nworkers<<", nrunning="<<nrunning<< std::endl;
					#endif

					// (A) initialize
					long prodcrit_counter  = 0L;
					long chaincrit_counter = 0L;
					long cancelled_element_counter = 0L;
					long cancelled_s_pair_counter  = 0L;
					long degbound_counter = 0L;
					const GpiSet& zero_reductions = get_set(NF_list_input.at((int) 0));
					GpiSet remove_from_running = {};

					std::ofstream debugfile(base_filename+"debug.txt", std::ios::app);


					// (B) build vector version of M
					std::vector<std::vector<std::vector<int> > > Mvec;
					for(GpiList::iterator Mi=M.begin(); Mi!=M.end(); ++Mi)
					{
						GpiList Mi_list = get_list(*Mi);
						std::vector<std::vector<int>> Mveci;
						for(GpiList::iterator Mii=Mi_list.begin(); Mii!=Mi_list.end(); ++Mii)
						{
							Mveci.emplace_back(list2vec(*Mii));
						}
						Mvec.emplace_back(Mveci);
					}



					/*
					debugfile << "firing update_Q transition with results ";
					for (GpiMap::const_iterator itNF = NF_list_input.begin(); itNF!=NF_list_input.end(); ++itNF)
					{
						if ((itNF->first).which()!=2) {
							GpiList::const_iterator it = get_list(itNF->second).begin();
							int index_i = boost::get<int>(*it); ++it;
							int index_j = boost::get<int>(*it); ++it;
							debugfile << "("<< index_i<<","<<index_j<<") ";
						}
					}
					debugfile << "\n";
					*/

					// (C) remove from back of queue as long as possible
					int Qcounter=0;
					for (sPairQueue::const_iterator itQ = Q.begin(); itQ!=Q.end(); Qcounter++)
					{
						int index_i = (itQ->first).first;
						int index_j = (itQ->first).second;
						GpiList ij = {index_i,index_j};
						GpiMap::const_iterator itNF = NF_list_input.find(ij);
						if (itNF == NF_list_input.end())
						{
							GpiSet::const_iterator itNF0 = zero_reductions.find(ij);
							if (itNF0 == zero_reductions.end())
				// CASE 1: next element (i,j) in Q has not yet finished: break
							{
								break;
							}
							else
				// CASE 2: (i,j) reduced to 0: have to remove it from Q (will be done later, together with all the other 0-reductions)
							{
								++itQ;
								--Qcounter;
								continue;
							}
						}
						else
				// CASE 3: (i,j) reduced to non-0: add as new element (and remove (i,j) from Q)
						{
							bool i_in_bl  = (blacklist.find((GpiVariant) index_i)     !=blacklist.end());
							bool j_in_bl  = (blacklist.find((GpiVariant) index_j)     !=blacklist.end());
							bool ij_in_bl = (blacklist.find(GpiSet({index_i,index_j}))!=blacklist.end());
							if (!(((i_in_bl || j_in_bl) && !ij_in_bl) || (i_in_bl && j_in_bl)))
							{

								GpiList NF = get_list(itNF->second);
								GpiList m = get_list(NF.back());
								int old_r = boost::get<int>(m.back());



								// (1) test if the new element could be reduced further
								std::vector<int> new_lead = list2vec(m.front());
								bool abort = false;
								for(int ind=old_r; ind<r; ind++)
								{
									if(divides_monom(Mvec[ind][0],new_lead))
									{
										#ifdef DEBUG_BBA
										std::cout << "M["<<ind<<"] divides lead, aborting" << std::endl;
										#endif
										abort = true;
										break;
									}
								}
								if (abort) {break;}

								debugfile << "r:"<<r<<"->"<<r+1<<": adding new element due to s-pair ("<< index_i<<","<<index_j<<") (old_r="<<old_r<<") with new lead [ ";
								//std::cout << " NEW ELEMENT DUE TO S-PAIR ("<<index_i<<","<<index_j<<") ---------------------------------------------------------------------------------------" << std::endl;

								// (2) add new element to M and increase r
								std::vector<std::vector<int>> Mvec_new;
								for(GpiList::iterator Mi=m.begin(); Mi!=m.end(); ++Mi)
								{
									std::vector<int> new_entry = list2vec(*Mi);
									Mvec_new.emplace_back(new_entry);

									debugfile << "( ";
									for (int x : new_entry) {
										debugfile << x << " ";
									}
									debugfile << ") ";

								}
								debugfile << "]\n";

								Mvec.emplace_back(Mvec_new);
								M.push_back(m);
								r++;

								#ifdef DEBUG_BBA
								std::cout << runtime_start << ": M.size()="<<M.size()<<", increasing r from " << r-1 << " to " << r << " due to spoly (" << index_i << "," << index_j << "),  new lead:           -------------------------"<< std::endl;
								print_variant(m);
								#endif


								// (3) save file containing the new GB element
								std::string save_filename = base_filename+"temporary_files/intermediate_result_"+std::to_string(index_i)+"_"+std::to_string(index_j);
								std::rename(save_filename.c_str(), (base_filename + "intermediate_files/f"+std::to_string(r)).c_str()); // NF_spoly can't be reduced further, so just rename its file to the new generator f{r}


								// (4) add or  exclude (PC/CC) new s-pairs involving the new element
								std::vector<std::vector<int>> Mr = Mvec.back();
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<r; ++Mi, i++)
								{
									bool add_to_Q = true;
									std::vector<int> lcm_i_r;

									if (blacklist.find((GpiVariant) i) != blacklist.end())
									{
										add_to_Q = false;
									}
									else
									{
										lcm_i_r = lcm((*Mi)[0], Mr[0]);
										//if (degBound>0 && degBound < deg(lcm_i_r))
										if (over_deg_bound(lcm_i_r, degBounds))
										{
											// if(r==34) {std::cout << "("<<i<<","<<r<<") OVER DEGREE BOUND" << std::endl;}
											add_to_Q=false;
											degbound_counter++;
											std::ofstream ijFile(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
										}
										if (test_PC((*Mi)[0],Mr[0])) // apply PC
										{
											// if(r==34) {std::cout << "PC("<<i<<","<<r<<") POSITIVE" << std::endl;}
											add_to_Q = false;
											prodcrit_counter++;
											std::ofstream ijFile(base_filename+"queue/product_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
										}
										else // apply CC
										{
											// if(r==34) {std::cout << "PC("<<i<<","<<r<<") NEGATIVE" << std::endl;}
											int k=1;
											for (std::vector<std::vector<std::vector<int> > >::iterator Mk=Mvec.begin(); k<=r; ++Mk, k++)
											{
												if(k!=i && k!=r)
												{
													if (test_CC(lcm_i_r, (*Mi)[0], Mr[0], (*Mk)[0]))
													{
														if(k<i)
														{
															add_to_Q = false;
															chaincrit_counter++;
															std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
															break;
														}
														else // thus i<k<r  (k>r is not possible)
														{
															std::vector<int> lcm_k_r = lcm((*Mk)[0], Mr[0]);
															if(!equal(lcm_k_r,lcm_i_r))
															{
																add_to_Q = false;
																chaincrit_counter++;
																std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
																break;
															}
														}
													}
												}
											}
										}
									}

									if (divides_monom(Mr[0],(*Mi)[0]) &&  (blacklist.find((GpiVariant) i)==blacklist.end()))
									{
										// new found lead monomial divides i-th lead monomial ==> put i in blacklist
										// (and Set(i,r) as the (i,r)-th spoly has to be reduced, it is not eliminated through CC!)
										add_to_blacklist.emplace(i);
										add_to_blacklist.emplace(GpiSet({i,r}));
										// remove (i,j) for all j from Q:
										queue_delete_i(Q, i, r, base_filename, "cancelled_element", &nrunning);
										cancelled_element_counter++;
									}

									if(add_to_Q)
									{
										queue_insert(Q, i, r, *Mi, Mr, lcm_i_r, base_filename, 0);
									}
								}


								// (5) remove old s-pairs due to chain condition
								bool first=true;
								for (sPairQueue::iterator Qk=Q.begin(); Qk!=Q.end(); )
								{
									//int ii = boost::get<int>(get_list(*Qk).front());
									//int jj = boost::get<int>(*std::next(get_list(*Qk).begin()));
									int ii = ((*Qk).first).first;
									int jj = ((*Qk).first).second;

									std::vector<int> lcm_i_j = lcm(Mvec[ii-1][0],Mvec[jj-1][0]);

									if(test_CC(lcm_i_j, Mvec[ii-1][0], Mvec[jj-1][0], Mvec[r-1][0]))
									{
										std::vector<int> lcm_i_r = lcm(Mvec[ii-1][0], Mvec[r-1][0]);
										std::vector<int> lcm_j_r = lcm(Mvec[jj-1][0], Mvec[r-1][0]);
										if(!equal(lcm_i_r,lcm_i_j) && !equal(lcm_j_r,lcm_i_j))
										{
											if (first)  {
												debugfile << "CC: removing indices ";
												first = false;
											}
											add_to_blacklist.emplace(GpiList({ii,jj}));
											Qk = Q.erase(Qk);
											//Qind.erase(std::make_pair(ii,jj));
											chaincrit_counter++;
											cancelled_s_pair_counter++;
											std::remove((base_filename+"queue/started/"+std::to_string(std::min(ii,jj))+"_"+std::to_string(std::max(ii,jj))).c_str());
											std::ofstream ijFile(base_filename+"queue/cancelled_s_pair/"+std::to_string(std::min(ii,jj))+"_"+std::to_string(std::max(ii,jj))); ijFile.close();
											debugfile << "("<<ii<<","<<jj<<") ";
										}
										else {++Qk;}
									}
									else {++Qk;}
								}
								if (!first) debugfile << "\n";
							}
						}


						// (6) remove from front of Q and advance to next element
						remove_from_running.insert(ij);
						itQ = queue_delete_i_j(Q, index_i, index_j, base_filename, "new_element", &nrunning);

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": increment: set size of Q(ueue) to " << Q.size() <<std::endl;
						#endif

						std::cout << "s(" << Q.size() << ")" << std::endl;


					}

					#ifdef DEBUG_BBA
					std::cout << "added "<<Qcounter<<" elements from the back of the Q(ueue)" << std::endl;
					#endif


					// (D) put the other non-0-reductions to paused_indices to reduce further:
					bool first=true;
					for (GpiMap::const_iterator itNF=NF_list_input.begin(); itNF!=NF_list_input.end(); ++itNF)
					{
						if(remove_from_running.find(itNF->first)==remove_from_running.end() && (itNF->first).which()!=2)
						{
							if (first) {
								debugfile << "pausing s-pairs: ";
								first = false;
							}
							GpiList::const_iterator it = get_list(itNF->second).begin();
							int index_i = boost::get<int>(*it); ++it;
							int index_j = boost::get<int>(*it); ++it;
							GpiList m = get_list(*it);
							int old_r = boost::get<int>(m.back());

							GpiStruct si;
							si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , index_i}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , index_j}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", old_r}));

							paused_indices.push_back(si);
							debugfile <<"("<<index_i<<","<<index_j<<") ";
						}
					}
					if (!first)	debugfile << "\n";


					// (E) remove 0-reductions from the queue
					first=true;
					for (GpiSet::const_iterator itNF0=zero_reductions.begin(); itNF0!=zero_reductions.end(); ++itNF0)
					{
						if (first) {
							debugfile << "reduced to 0: ";
							first = false;
						}
						const GpiList& ij = get_list(*itNF0);
						int index_i = boost::get<int>(ij.front());
						int index_j = boost::get<int>(ij.back());
						remove_from_running.insert(GpiList({index_i,index_j}));
						queue_delete_i_j(Q, index_i, index_j, base_filename, "zero_reduction", &nrunning);

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": remove_from_Q: removed element (" << index_i << "," << index_j << ") from Q(ueue) as it reduced to 0, size of Q: " << Q.size() <<std::endl;
						#endif
						int Q_size = Q.size();
						if (Q_size%100==0 || (Q_size<100 && Q_size%10==0))
						{
							std::cout << "(" << Q_size << ")" << std::endl;
						}
						debugfile <<"("<<index_i<<","<<index_j<<") ";
					}
					if (!first)	debugfile << "\n";


					// (F) update LOG.txt:
					std::ofstream logFile(base_filename+"LOG.txt");
					logFile << r << '\n';
					logFile << (Q.size());
					logFile.close();
					// current Queue:
					debugfile << "\n";
					for (sPairQueue::const_iterator itQ = Q.begin(); itQ!=Q.end(); ++itQ)
					{
						int index_i = (itQ->first).first;
						int index_j = (itQ->first).second;
						std::cout << "    ("<< index_i<<","<<index_j<<")" << std::endl;
						debugfile << "("<< index_i<<","<<index_j<<") ";
					}
					debugfile << "\n\n";
					debugfile.close();


					// (G) termination condition + update of the r, Qback and blacklist places
					if(Q.size()>0)
					{
						//Qback.i = boost::get<int>(           get_list(Q.back()).front() );
						//Qback.j = boost::get<int>(*std::next(get_list(Q.back()).begin()));
						int new_Qback_i = Q.front_key().first;
						int new_Qback_j = Q.front_key().second;

						if (new_Qback_i!=Qback.i || new_Qback_j!=Qback.j || r!=r_in || add_to_blacklist.size()>0)
						{
							GpiStruct new_Qback;
							new_Qback.emplace_back(std::pair<std::string,GpiVariant>({"i"    , new_Qback_i}));
							new_Qback.emplace_back(std::pair<std::string,GpiVariant>({"j"    , new_Qback_j}));
							GpiStruct new_values;
							new_values.emplace_back(std::pair<std::string,GpiVariant>({"first" , new_Qback}));
							new_values.emplace_back(std::pair<std::string,GpiVariant>({"second", r}));
							new_values.emplace_back(std::pair<std::string,GpiVariant>({"third" , add_to_blacklist}));
							update_Qback_r.emplace_back(new_values);
						}

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": current Qback:  " << new_Qback_i << "," << new_Qback_j << std::endl;
						#endif

//						Q.display(); //!!!

					}
					else // queue empty ==> terminate Buchberger algorithm
					{
						std::cout << runtime_start << ": ########################################## Buchberger Algorithm finished ##########################################" << std::endl;
						BB_finished.emplace_back(CONTROL_TOKEN);
					}


					// (H) start jobs:
					update_job_queue = GpiList({remove_from_running});
					for(sPairQueue::iterator entry=Q.begin(); entry!=Q.hend(); ++entry)
					{
						std::pair<int,int> indices = (*entry).first;
						#ifdef DEBUG_BBA
						std::cout << "adding " << indices.first << "," << indices.second << " to update_job_queue" << std::endl;
						#endif
						update_job_queue.emplace_back(GpiList({indices.first,indices.second}));
					}


					// (I) runtime (and other) measurements
					runtime[(std::string) "PRODUCT CRITERION"] = GpiList({-1L, -1L, -1L,  prodcrit_counter});
					runtime[(std::string) "CHAIN CRITERION"] = GpiList({-1L, -1L, -1L, chaincrit_counter});
					runtime[(std::string) "DEGREE BOUND"] = GpiList({-1L, -1L, -1L, degbound_counter});
					runtime[(std::string) "CANCELLED ELEMENTS"] = GpiList({-1L, -1L, -1L,  cancelled_element_counter});
					runtime[(std::string) "CANCELLED S-PAIRS"] = GpiList({-1L, -1L, -1L,  cancelled_s_pair_counter});
					long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
					runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

					std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-number-of-tokens port="nT_started_indices" place="place_started_indices"/>
			<connect-read port="nworkers" place="place_nworkers"/>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<connect-read port="degBounds" place="place_degBounds"/>
			<!--connect-read port="Q_in" place="place_Q"/-->
			<connect-read port="r_in" place="place_r"/>
			<connect-read port="Qback" place="place_Qback"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-in port="NF_list_input" place="place_NF_list_input"/>
			<connect-in port="enable_update_Q" place="place_enable_update_Q"/>
			<connect-inout port="nrunning" place="place_nrunning"/>
			<connect-inout port="M" place="place_M"/>
			<connect-out port="runtime" place="place_runtime"/>
			<connect-out port="update_job_queue" place="place_update_job_queue"/>
			<connect-out port="enable_get_NF_list" place="place_enable_get_NF_list"/>
			<connect-out-many port="update_Qback_r" place="place_update_Qback_r"/>
			<connect-out-many port="paused_indices" place="place_paused_indices"/>
			<connect-out-many port="BB_finished" place="place_BB_finished"/>
		</transition>



		<transition name="restart" priority="1">
			<defun>
				<in name="r" type="int"/>
				<in name="index" type="running_reduction"/>
				<out name="index" type="running_reduction"/>
				<expression/>
			</defun>
			<condition>
				(${index.old_r} :lt: ${r})
			</condition>
			<connect-read port="r" place="place_r"/>
			<connect-in port="index" place="place_paused_indices"/>
			<connect-out port="index" place="place_started_indices"/>
		</transition>


		<transition name="update_job_queue" priority="5">
			<defun>
				<require key="update_job_queue" mandatory="true"/>
				<in name="update_job_queue" type="list"/>
				<inout name="job_queue_running" type="set"/>
				<inout name="job_queue" type="list"/>
				<out name="enable_update_Q" type="control"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="update_job_queue(enable_update_Q, job_queue_running, update_job_queue, job_queue)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[
						std::cout << "ENTERING update_job_queue" << std::endl;

						#ifdef DEBUG_BBA
						std::cout << "update:" << std::endl;
						print_variant(update_job_queue);
						std::cout << "running:" << std::endl;
						print_variant(job_queue_running);
						std::cout << "before:" << std::endl;
						print_variant(job_queue);
						#endif

						job_queue = GpiList({});

						GpiList::const_iterator it=update_job_queue.begin();
						GpiList remove_from_running = get_list(*it); ++it;
						for (; it!=update_job_queue.end(); ++it) {
							if (job_queue_running.find(*it)==job_queue_running.end()) {
								job_queue.emplace_back(*it);
							}
						}

						for (GpiList::iterator it2=remove_from_running.begin(); it2!=remove_from_running.end(); ++it2)
						{
							GpiList NF = get_list(*it2);
							it = NF.begin();
							int i = boost::get<int>(*it2); ++it2;
							int j = boost::get<int>(*it2);
							job_queue_running.erase(GpiList({i,j}));
						}

						#ifdef DEBUG_BBA
						std::cout << "after:" << std::endl;
						print_variant(job_queue);
						#endif

						std::cout << "EXITING update_job_queue" << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-in port="update_job_queue" place="place_update_job_queue"/>
			<connect-inout port="job_queue_running" place="place_job_queue_running"/>
			<connect-inout port="job_queue" place="place_job_queue"/>
			<connect-out port="enable_update_Q" place="place_enable_update_Q"/>
		</transition>


		<transition name="start_jobs" priority="5">
			<defun>
				<require key="start_jobs" mandatory="true"/>
				<in name="nworkers" type="int"/>
				<in name="nT_started_indices" type="unsigned long"/>
				<!--in name="r" type="int"/-->
				<inout name="job_queue" type="list"/>
				<inout name="job_queue_running" type="set"/>
				<out name="started_indices" type="list"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="start_jobs(job_queue_running, job_queue, started_indices, nT_started_indices, nworkers)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[
						//std::cout << "ENTERING start_jobs (nrunning="<<nT_started_indices<<", nworkers="<<nworkers<<")" << std::endl;

						unsigned long nrunning = nT_started_indices;

						#ifdef DEBUG_BBA
						//std::cout << "nrunning: " <<nrunning<< ", nworkers: " <<nworkers<< ", job_queue:" << std::endl;
						//print_variant(job_queue);
						#endif

						//while (job_queue.size()>0 && nrunning*2<=nworkers*3) {
						while (job_queue.size()>0 && nrunning < nworkers) { // only have as many jobs running as there are NF_of_spoly transitions

							GpiList::const_iterator it = get_list(job_queue.front()).begin();
							int i = boost::get<int>(*it); ++it;
							int j = boost::get<int>(*it); ++it;

							GpiStruct si;
							si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , j}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) 0}));

							#ifdef DEBUG_BBA
							std::cout << " start_jobs: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
							#endif
							// add (i,j) to started indices:
							started_indices.push_back(si);
							job_queue_running.insert(GpiList({i,j}));
							nrunning++;
							job_queue.pop_front();
						}

						#ifdef DEBUG_BBA
						//std::cout << "job_queue after:" << std::endl;
						//print_variant(job_queue);
						#endif

						//std::cout << "EXITING start_jobs" << std::endl;
						//((stack_size(${job_queue}) :gt: 0UL) :and: (${nT_started_indices}*2UL :le: (tounsignedlong(${nworkers})*3UL) ) )
					]]></code>
				</module>
			</defun>
			<condition>
			(stack_size(${job_queue}) :gt: 0UL)
			</condition>
			<connect-read port="nworkers" place="place_nworkers"/>
			<!--connect-read port="r" place="place_r"/-->
			<connect-number-of-tokens port="nT_started_indices" place="place_started_indices"/>
			<connect-inout port="job_queue" place="place_job_queue"/>
			<connect-inout port="job_queue_running" place="place_job_queue_running"/>
			<connect-out-many port="started_indices" place="place_started_indices"/>
		</transition>


		<!--transition name="put_token_to_start_NF_workers" priority="5">
			<defun>
				<require key="queue" mandatory="true"/>
				<in name="nT_NF" type="unsigned long"/>
				<in name="r" type="int"/>
				<inout name="once" type="control"/>
				<out name="NF" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="put_token_to_start_NF_workers(nT_NF, NF)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<code><![CDATA[
						std::cout << "ENTERING put_token_to_start_NF_workers ("<<nT_NF<<")" << std::endl;

						NF = {};

						std::cout << "EXITING put_token_to_start_NF_workers" << std::endl;
					]]></code>
				</module>
			</defun>
			<condition>
				(${nT_NF} :eq: 0UL)
			</condition>
			<connect-number-of-tokens port="nT_NF" place="place_NF"/>
			<connect-read port="r" place="place_r"/>
			<connect-inout port="once" place="place_once"/>
			<connect-out port="NF" place="place_NF"/>
		</transition-->

		<!--transition name="nT_test">
			<defun>
				<require key="queue" mandatory="true"/>
				<in name="nT_NF" type="unsigned long"/>
				<inout name="once" type="control"/>
				<out name="NF" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="nT_test(nT_NF, NF)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<code><![CDATA[
						std::cout << "ENTERING nT_test ("<<nT_NF<<") !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" << std::endl;

						NF = {};

						std::cout << "EXITING nT_test" << std::endl;
					]]></code>
				</module>
			</defun>
			<condition>
				(${nT_NF} :eq: 0UL)
			</condition>
			<connect-number-of-tokens port="nT_NF" place="place_testplace"/>
			<connect-inout port="once" place="place_once"/>
			<connect-out port="NF" place="place_testplace"/>
		</transition>

		<transition name="nT_confirm">
			<defun>
				<require key="queue" mandatory="true"/>
				<in name="nT_NF" type="unsigned long"/>
				<inout name="NF" type="list"/>
