<defun name="buchberger">
	<include-structs href="structures.xpnet"/>

	<in name="input" type="string" place="place_input"/>
	<in name="base_filename" type="string" place="place_base_filename"/>
	<in name="installdir" type="string" place="place_installdir"/>
	<out name="output" type="string" place="place_output"/>
	<out name="singular_options" type="bitset" place="place_singular_options"/>
	<out name="runtime" type="map" place="place_runtime"/>
	<net>
		<place name="place_base_filename" type="string"/>
		<place name="place_installdir" type="string"/>
		<place name="place_singular_options" type="bitset"/>
		<place name="place_input" type="string"/>
		<place name="place_output" type="string"/>
		<place name="place_BB_finished" type="control"/>
		<place name="place_r" type="int"/>
		<place name="place_syzygy_indices" type="set"/>
		<place name="place_n_syzygies" type="int">
			<token>
					<value>0</value>
			</token>
		</place>
		<place name="place_update_r" type="pair__int__set"/>
		<place name="place_M" type="list"/>
		<place name="place_balNF" type="control"/>
		<place name="place_job_queue" type="list"/>
		<place name="place_update_job_queue" type="list"/>
		<place name="place_job_queue_running" type="set"/>
		<!--place name="place_started_indices" type="running_reduction"/-->
		<place name="place_started_indices" type="list"/>
		<place name="place_paused_indices" type="running_reduction"/>
		<place name="place_NF" type="reduction_result"/>
		<place name="place_needed_indices" type="needed_index"/>
		<place name="place_generator_indices" type="list"/>
		<place name="place_blacklist" type="set"/>
		<place name="place_degBounds" type="list"/>
		<place name="place_nworkers" type="unsigned long"/>
		<place name="place_runtime" type="map"/>
		<place name="place_NF_runtime" type="timing"/>
		<place name="place_NF_list" type="list"/>
		<place name="place_NF_list_input" type="list"/>
		<place name="place_max_batch_size" type="long"/>
		<place name="place_head_size_factor" type="double"/>
		<place name="place_target_time" type="long"/>
		<place name="place_mv_avg_base" type="double"/>
		<place name="place_current_time" type="moving_avg"/>
		<place name="place_syz_comp" type="long"/>
		<place name="place_red_syz" type="long"/>
		<place name="place_measure_timings" type="long"/>
		<place name="place_rank" type="int"/>
		<place name="place_enable_get_NF_list" type="control">
			<token>
					<value>[]</value>
			</token>
		</place>
		<place name="place_enable_update_Q_1" type="control">
			<token>
					<value>[]</value>
			</token>
		</place>
		<place name="place_enable_update_Q_2" type="control">
			<token>
					<value>[]</value>
			</token>
		</place>



		<transition name="init">
			<defun>
				<require key="misc" mandatory="true"/>
       	<in name="base_filename" type="string"/>
				<in name="input" type="string"/>
				<in name="installdir" type="string"/>
				<out name="nworkers" type="unsigned long"/>
				<out name="degBounds" type="list"/>
				<out name="started_indices" type="list"/>
				<out name="job_queue" type="list"/>
				<out name="job_queue_running" type="set"/>
				<out name="blacklist" type="set"/>
				<out name="r" type="int"/>
				<out name="M" type="list"/>
				<out name="singular_options" type="bitset"/>
				<out name="NF_list" type="list"/>
				<out name="runtime" type="map"/>
				<out name="balNF" type="list"/>
				<out name="BB_finished" type="list"/>
				<out name="syz_comp" type="long"/>
				<out name="red_syz" type="long"/>
				<out name="measure_timings" type="long"/>
				<out name="rank" type="int"/>
				<out name="max_batch_size" type="long"/>
				<out name="head_size_factor" type="double"/>
				<out name="target_time" type="long"/>
				<out name="mv_avg_base" type="double"/>
				<out name="current_time" type="moving_avg"/>
				<out name="syzygy_indices" type="set"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_init(NF_list, started_indices, installdir, degBounds, nworkers, runtime, base_filename, input, r, M, singular_options, balNF, blacklist, BB_finished, syz_comp, red_syz, measure_timings, job_queue, job_queue_running, max_batch_size, head_size_factor, target_time, current_time, mv_avg_base, rank, syzygy_indices)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
						<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="fstream"/>
					<cinclude href="chrono"/>
					<cinclude href="boost/thread/thread.hpp"/>
					<cinclude href="sys/stat.h"/>
					<cinclude href="sys/types.h"/>

					<code><![CDATA[
						double runtime_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						//std::cout << runtime_start << ": ENTERING INIT " << std::endl;

						int nvars;

						// static initializations
						job_queue_running = GpiSet({});
						NF_list = GpiList({});
						blacklist = GpiSet({});
						syzygy_indices = GpiSet({});

						std::string singular_function_name = "init";

						#ifdef DEBUG_BBA
						std::cout << "start time (time since epoch in ms): " << runtime_start << std::endl;
						std::cout << runtime_start << ": entering " << singular_function_name << std::endl;
						#endif

						// make subdirectories:
						mkdir((base_filename + "intermediate_files"       ).c_str(), 0777);
						mkdir((base_filename + "temporary_files"          ).c_str(), 0777);
						mkdir((base_filename + "result"                   ).c_str(), 0777);
						mkdir((base_filename + "memory"                   ).c_str(), 0777);
						mkdir((base_filename + "queue"                    ).c_str(), 0777);
						mkdir((base_filename + "queue/started"            ).c_str(), 0777);
						mkdir((base_filename + "queue/paused"             ).c_str(), 0777);
						mkdir((base_filename + "queue/zero_reduction"     ).c_str(), 0777);
						mkdir((base_filename + "queue/new_element"        ).c_str(), 0777);
						mkdir((base_filename + "queue/chain_criterion"    ).c_str(), 0777);
						mkdir((base_filename + "queue/product_criterion"  ).c_str(), 0777);
						mkdir((base_filename + "queue/different_component").c_str(), 0777);
						mkdir((base_filename + "queue/cancelled_s_pair"   ).c_str(), 0777);
						mkdir((base_filename + "queue/cancelled_element"  ).c_str(), 0777);
						mkdir((base_filename + "queue/degree_bound"       ).c_str(), 0777);
						std::ifstream queueFileIn(base_filename+"queue/NOT_STARTED");
						bool prev_queue_had_started = !queueFileIn.good();
						queueFileIn.close();
						std::ofstream queueFile(base_filename+"queue/NOT_STARTED");
						queueFile.close();
						std::remove((base_filename+"prot.txt").c_str());


						long nworkers_long=0; // max number of workers given to NF_of_spoly transition
						int prev_r=0; // value of r from a previous computation that is being continued
						GpiList si_opt;
						std::vector<std::vector<std::vector<int> > > Mvec; // lead monomials as a vector of exponent vectors (last entry = component)
						RESOLVE_INTERFACE_FUNCTION(singular_init) (base_filename, input, prev_queue_had_started, &Mvec, &nworkers_long, &degBounds, &target_time, &max_batch_size, &head_size_factor, &si_opt, &prev_r, &syz_comp, &red_syz, &measure_timings, &rank, &runtime);
						nworkers = (unsigned long) nworkers_long;
						singular_options = uint2bitset(boost::get<long>(si_opt.front()), boost::get<long>(si_opt.back()));
						current_time.avg = static_cast<double>(target_time); // thus in the initial iteration(s) of NF_of_spoly the batch size will be 1
						current_time.total = 0.0;
						current_time.count = 0.0;
						current_time.start = runtime_start;
						mv_avg_base = 1.0+1.0/(static_cast<double>(target_time) * TIME_SCALE_FACTOR);

						std::ofstream prot_file(base_filename+"prot.txt", std::ios::app);
						if (singular_options.is_element(INTSTRATEGY)) { prot_file << "{intStrategy}"; }
						if (singular_options.is_element(REDTAIL)) { prot_file << "{redTail}"; }
						if (singular_options.is_element(PROT) && syz_comp>0) { prot_file << "{"<<syz_comp<<"}"; }
						prot_file.close();

						sPairQueue Q(syz_comp);

						r = Mvec.size();
						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": r=" << r << ", prev_r=" << prev_r << ", prev_queue_had_started=" << prev_queue_had_started << ", degBounds="<< std::endl;
						print_variant(degBounds);
						#endif


						long prodcrit_counter  = 0L;
						long diff_comp_counter = 0L;
						long chaincrit_counter = 0L;
						long degbound_counter  = 0L;

						if (prev_r>0 && prev_queue_had_started) // use previous state to initialize Q(ueue)
						{
							r=prev_r;
							if(TRACE>0)
							{
								prev_r=TRACE;
							}
							int j=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mj=Mvec.begin(); j<=r; ++Mj, j++)
							{
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<j; ++Mi, i++)
								{
									std::ifstream ijFileIn(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j));
									std::ifstream ijDegBoundFileIn(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j));
									std::vector<int> lcm_i_j = lcm((*Mi)[0], (*Mj)[0]);

									if ((ijFileIn.good() || ijDegBoundFileIn.good()))
									{
										std::ifstream &tmpFile = ijFileIn.good() ? ijFileIn : ijDegBoundFileIn;
										std::string currLine;
										std::getline(tmpFile, currLine);
										int old_r = std::stoi(currLine);

										ijFileIn.close();
										ijDegBoundFileIn.close();
										if (over_deg_bound(lcm_i_j, degBounds))
										{
											// move from started to degree_bound
											ijFileIn.close();
											//FIX: std::ofstream ijFileOut(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)); ijFileOut.close();
											//FIX: std::remove((base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j)).c_str());
										}
										else
										{
											// move from degree_bound to started
											//FIX: std::ofstream ijFileOut(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j)); ijFileOut.close();
											//FIX: std::remove((base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)).c_str());

											std::ifstream ijResFileIn(base_filename+"temporary_files/intermediate_result_"+std::to_string(i)+"_"+std::to_string(j));
											if(ijResFileIn.good())
											{
												GpiVariant si;
												poke("i"    , si, i);
												poke("j"    , si, j);
												poke("old_r", si, old_r);
												//poke("PC", si, PC); // FIX restart system!

												#ifdef DEBUG_BBA
												std::cout << runtime_start << ": init: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
												#endif

												// add (i,j) to started indices:
												started_indices.push_back(si);
											}

											// add (i,j) and information about lcm(fi,fj) to the queue:
											queue_insert(Q, i, j, old_r, *Mi, *Mj, lcm_i_j);
											nvars = lcm_i_j.size()-1;
										}
									}
								}
							}
						}
						else
						{
							int j=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mj=Mvec.begin(); j<=r; ++Mj, j++)
							{
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<j; ++Mi, i++)
								{
									bool add_to_Q = true;
									bool PC = false;
									std::vector<int> lcm_i_j = lcm((*Mi)[0], (*Mj)[0]);
									//if (degBound>0 && degBound < deg(lcm_i_j))
									if (over_deg_bound(lcm_i_j, degBounds))
									{
										add_to_Q=false;
										degbound_counter++;
										//FIX: std::ofstream ijFile(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
									}
									int PC_res = test_PC((*Mi)[0],(*Mj)[0],rank); // 1: PC positive,  2: different lead components,  0: else
									if (PC_res!=0) // apply PC
									{
										add_to_Q = false;
										if (PC_res==1) {
											prodcrit_counter++;
											//FIX: std::ofstream ijFile(base_filename+"queue/product_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
										}
										else {
											diff_comp_counter++;
											//FIX: std::ofstream ijFile(base_filename+"queue/different_component/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
										}

										if(syz_comp>0 && PC_res==1) {
											add_to_Q = true;
											PC = true;
											// make NF_of_spoly construct the syzygy instead
										}
									}
									else // apply CC
									{
										int k=1;
										for (std::vector<std::vector<std::vector<int> > >::iterator Mk=Mvec.begin(); k<=r; ++Mk, k++)
										{
											if(k!=i && k!=j)
											{
												if (test_CC(lcm_i_j, (*Mi)[0], (*Mj)[0], (*Mk)[0]))
												{
													if(k<i)
													{
														add_to_Q = false;
														chaincrit_counter++;
														//FIX: std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
														break;
													}
													else { if(k<j)
													{
														std::vector<int> lcm_k_j = lcm((*Mk)[0], (*Mj)[0]);
														if(!equal(lcm_k_j,lcm_i_j))
														{
															add_to_Q = false;
															chaincrit_counter++;
															//FIX: std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
															break;
														}
													}
													else // (k>j)
													{
														std::vector<int> lcm_i_k = lcm((*Mi)[0], (*Mk)[0]);
														std::vector<int> lcm_j_k = lcm((*Mj)[0], (*Mk)[0]);
														if(!equal(lcm_i_k,lcm_i_j) && !equal(lcm_j_k,lcm_i_j))
														{
															add_to_Q = false;
															chaincrit_counter++;
															//FIX: std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
															break;
														}
													}}
												}
											}
										}
									}

									if(add_to_Q)
									{
										// add (i,j) and information about lcm(fi,fj) to the queue:
										queue_insert(Q, i, j, (int) 0, *Mi, *Mj, lcm_i_j, PC);
										nvars = lcm_i_j.size()-1;
									}
								}
							}
						}

						// build M
						M = vec2list(Mvec);

						// start jobs:
						job_queue = GpiList({});
						int insert_counter=0;
						long batch_size = static_cast<long>(std::llround(static_cast<double>(target_time)/current_time.avg));
						batch_size = std::min(batch_size, max_batch_size);
						batch_size = std::max(batch_size, 1L);
						long head_size = batch_size * nworkers * head_size_factor;
						for(sPairQueue::iterator entry=Q.begin(); insert_counter<head_size && entry!=Q.end(); ++entry)
						{
							std::pair<int,int> indices = entry->first;
							bool PC = (entry->second).PC;
							job_queue.emplace_back(GpiList({indices.first,indices.second,(int) 0, (int) (PC ? 2 : 0)}));
							insert_counter++;
						}


						if(Q.size()==0)
						{
							BB_finished.emplace_back(CONTROL_TOKEN);
						}
						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": ----------------------------- Q.size() after init: " << Q.size() << std::endl;
						std::cout << runtime_start << ": --------------- started_indices.size() after init: " << started_indices.size() << std::endl;
						#endif

						// init balNF to limit the number of workers dedicated to NF_of_spoly
						for(int ii=0; ii<nworkers; ii++)
						{
							balNF.emplace_back(CONTROL_TOKEN);
						}

						// init LOG file
						std::ofstream logFile(base_filename+"LOG.txt");
						logFile << "Gröbner Basis:\n";
						logFile << " GB: " << r << "\n";
						logFile << "syz: " << 0 << "\n";
						logFile << "Queue of s-pairs:\n";
						logFile << " GB: " << Q.size() << "\n";
						logFile << "syz: " << 0;
						logFile.close();

						#ifdef DEBUGFILE_BBA
						std::ofstream debugfile(base_filename+"debug.txt");
						debugfile << "initial lead monomials:\n";
						for(std::vector<std::vector<int>> leadmon : Mvec)
						{
							//debugfile << "[ ";
							//for(std::vector<int> entry : leadmon)
							std::vector<int> entry = leadmon.front();
							//{
								debugfile << "( ";
								for (int x : entry) {
									debugfile << x << " ";
								}
								//debugfile << ") ";
								debugfile << ")\n";

							//}
							//debugfile << "]\n";
						}
						debugfile << "\n";

						displayQ(Q, debugfile);
						debugfile << "\n\n";
						debugfile.close();
						#endif

						// mark queue as "started"
						std::remove((base_filename+"queue/NOT_STARTED").c_str());


						#ifdef DEBUG_BBA
						std::cout << "\nLEADS AFTER INIT:"<< std::endl;
						print_variant(M);

						std::cout << runtime_start << ": exiting " << singular_function_name << std::endl;
						#endif

						serialize_queue(Q, base_filename+"queue/Q", nvars);

						double runtime_stop = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						if (measure_timings != 0) {
							runtime[(std::string) "PRODUCT CRITERION"] = GpiList({-1.0, -1.0, -1.0, prodcrit_counter});
							runtime[(std::string) "DIFFERENT COMPONENT"] = GpiList({-1.0, -1.0, -1.0,  diff_comp_counter});
							runtime[(std::string) "CHAIN CRITERION"] = GpiList({-1.0, -1.0, -1.0, chaincrit_counter});
							runtime[(std::string) "DEGREE BOUND"] = GpiList({-1.0, -1.0, -1.0, degbound_counter});
							runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});
						}

						//std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<connect-in port="input" place="place_input"/>
			<connect-out port="nworkers" place="place_nworkers"/>
			<connect-out port="degBounds" place="place_degBounds"/>
			<connect-out port="blacklist" place="place_blacklist"/>
			<connect-out port="r" place="place_r"/>
			<connect-out port="M" place="place_M"/>
			<connect-out port="NF_list" place="place_NF_list"/>
			<connect-out port="runtime" place="place_runtime"/>
			<connect-out port="singular_options" place="place_singular_options"/>
			<connect-out port="job_queue" place="place_job_queue"/>
			<connect-out port="job_queue_running" place="place_job_queue_running"/>
			<connect-out port="max_batch_size" place="place_max_batch_size"/>
			<connect-out port="head_size_factor" place="place_head_size_factor"/>
			<connect-out port="target_time" place="place_target_time"/>
			<connect-out port="mv_avg_base" place="place_mv_avg_base"/>
			<connect-out port="current_time" place="place_current_time"/>
			<connect-out port="syz_comp" place="place_syz_comp"/>
			<connect-out port="red_syz" place="place_red_syz"/>
			<connect-out port="measure_timings" place="place_measure_timings"/>
			<connect-out port="rank" place="place_rank"/>
			<connect-out port="syzygy_indices" place="place_syzygy_indices"/>
			<connect-out-many port="started_indices" place="place_started_indices"/>
			<connect-out-many port="balNF" place="place_balNF"/>
			<connect-out-many port="BB_finished" place="place_BB_finished"/>
		</transition>


		<transition name="NF_of_spoly" priority="3">
			<defun>
				<require key="compute" mandatory="true"/>
				<properties name="gspc">
					<properties name="monitor">
						<properties name="color">
							<property key="started">
							    "
								${ncols} := 8;
								${YELLOW}  :=  ${ncols}-min(${ncols},abs(mod(${ncols}*0 + ${r}-1, ${ncols}*3)-${ncols}));
								${CYAN}    :=  ${ncols}-min(${ncols},abs(mod(${ncols}*1 + ${r}-1, ${ncols}*3)-${ncols}));
								${MAGENTA} :=  ${ncols}-min(${ncols},abs(mod(${ncols}*2 + ${r}-1, ${ncols}*3)-${ncols}));
								${color} := (${YELLOW} * 0x010100 + ${CYAN} * 0x000101 + ${MAGENTA} * 0x010001);
								${tmp} := stack_top(${started_indices});
								(31-10*${tmp.syzygy}) * ${color};
								"
							</property>
							<property key="finished">
							   	"
							   	${ncols} := 4;
								2 * (0x030f00 * (${ncols}-min(${ncols},abs(mod( ${r}-1 ,${ncols}*3)-${ncols}))) + 0x00030f * (${ncols}-min(${ncols},abs((mod(${ncols}+ ${r}-1 ,${ncols}*3))-${ncols}))) + 0x0f0003 * (${ncols}-min(${ncols},abs((mod(${ncols}*2+ ${r}-1 ,${ncols}*3))-${ncols}))));
								${RED}     :=  ${ncols}-min(${ncols},abs(mod(             ${r}-1, ${ncols}*6)-${ncols}));
								${YELLOW}  :=  ${ncols}-min(${ncols},abs(mod(${ncols}   + ${r}-1, ${ncols}*6)-${ncols}));
								${GREEN}   :=  ${ncols}-min(${ncols},abs(mod(${ncols}*2 + ${r}-1, ${ncols}*6)-${ncols}));
								${CYAN}    :=  ${ncols}-min(${ncols},abs(mod(${ncols}*3 + ${r}-1, ${ncols}*6)-${ncols}));
								${BLUE}    :=  ${ncols}-min(${ncols},abs(mod(${ncols}*4 + ${r}-1, ${ncols}*6)-${ncols}));
								${MAGENTA} :=  ${ncols}-min(${ncols},abs(mod(${ncols}*5 + ${r}-1, ${ncols}*6)-${ncols}));
								4 * (${RED} * 0x0f0000 + ${YELLOW} * 0x0f0f00 + ${GREEN} * 0x000f00 + ${CYAN} * 0x000f0f + ${BLUE} * 0x00000f + ${MAGENTA} * 0x0f000f);								
								
							   	${ncols} := 8;
								${YELLOW}  :=  ${ncols}-min(${ncols},abs(mod(${ncols}*0 + ${r}-1, ${ncols}*3)-${ncols}));
								${CYAN}    :=  ${ncols}-min(${ncols},abs(mod(${ncols}*1 + ${r}-1, ${ncols}*3)-${ncols}));
								${MAGENTA} :=  ${ncols}-min(${ncols},abs(mod(${ncols}*2 + ${r}-1, ${ncols}*3)-${ncols}));
								${color} := (${YELLOW} * 0x010100 + ${CYAN} * 0x000101 + ${MAGENTA} * 0x010001);								
								${tmp} := stack_top(${started_indices});
								(31-10*${tmp.syzygy}) * ${color};
								"
							</property>
							<property key="failed">
								"0xff0000"
							</property>
						</properties>
						<property key="tooltip">
						   "${tooltip.r} := ${r}; 
							${tooltip.batch_size} := int(stack_size(${started_indices})); 
							${tooltip.indices} := ${started_indices}; 
							${tooltip};"
						</property>
					</properties>
				</properties>
				<in name="base_filename" type="string"/>
				<in name="blacklist" type="set"/>
				<in name="singular_options" type="bitset"/>
				<in name="r" type="int"/>
				<in name="syz_comp" type="long"/>
				<in name="red_syz" type="long"/>
				<in name="target_time" type="long"/>
				<in name="measure_timings" type="long"/>
				<in name="M" type="list"/>
				<in name="started_indices" type="list"/>
				<inout name="balNF" type="control"/>
				<out name="started_indices_out" type="list"/>
				<out name="NF" type="list"/>
				<out name="NF_runtime" type="list"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_NF_of_spoly(runtime, base_filename, singular_options, r, syz_comp, red_syz, target_time, measure_timings, started_indices, started_indices_out, NF, NF_runtime, blacklist, M)">
					<cinclude href="interface/buchberger_interface.hpp"/>
						<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="fstream"/>
					<cinclude href="boost/archive/binary_iarchive.hpp"/>
					<cinclude href="boost/archive/binary_oarchive.hpp"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
						if (started_indices.size()==0) std::cout << "WARNING: NF_of_spoly called with empty started_indices" << std::endl;
						//std::cout << "ENTERING NF_of_spoly" << std::endl;
						std::string singular_function_name = "NF_of_spoly";
						double runtime_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						double runtime_tmp = runtime_start;
						int NF_size=0;
						for (GpiList::const_iterator sit=started_indices.begin(); sit!=started_indices.end(); ++sit)
						{
							int started_indices_i      = boost::get<int>(peek("i"     ,*sit)->get());
							int started_indices_j      = boost::get<int>(peek("j"     ,*sit)->get());
							int started_indices_old_r  = boost::get<int>(peek("old_r" ,*sit)->get());
							int started_indices_syzygy = boost::get<int>(peek("syzygy",*sit)->get());


							bool i_cancelled  = (blacklist.find(started_indices_i)                             !=blacklist.end());
							bool j_cancelled  = (blacklist.find(started_indices_j)                             !=blacklist.end());
							bool ij_excepted  = (blacklist.find(GpiSet ({started_indices_i,started_indices_j}))!=blacklist.end());
							bool ij_cancelled = (blacklist.find(GpiList({started_indices_i,started_indices_j}))!=blacklist.end());
							if (((i_cancelled || j_cancelled) && !ij_excepted) || (i_cancelled && j_cancelled) || ij_cancelled) {
								continue;
							}

							double read_poly_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

							// add generators to a static variable, so each element will be read in only once per worker
							static std::list<poly> generators;
							//static_assert(sizeof(poly)==sizeof(void*));
							for (int k=generators.size()+1; k<=r; k++)
							{
								generators.emplace_back(RESOLVE_INTERFACE_FUNCTION(read_generator) (base_filename, k));
							}

							double read_poly_stop = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
							if (measure_timings != 0) {
								runtime[(std::string) "reading generators in NF_of_spoly (static)"] = GpiList({-1.0, read_poly_stop, read_poly_stop-read_poly_start, 1L});
							}

							RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute_NF) (base_filename, generators, r, started_indices_i, started_indices_j, started_indices_old_r, started_indices_syzygy, syz_comp, red_syz, singular_options, measure_timings, &runtime, &NF); //## handle runtime better (maybe pass a temp. variable and then add to runtime?)

							#ifdef DEBUG_BBA
							if(NF.size()>NF_size)
							{
								NF_size = NF.size();
								std::cout << runtime_start << ": NF_of_spoly: adding ("<<boost::get<int>(peek("i",NF.back())->get())<<","<<boost::get<int>(peek("j",NF.back())->get())<<") to NF (old_r="<<started_indices_old_r<<", r="<<r<<")" << std::endl;
							}
							#endif

							GpiVariant time;
							poke("start", time, runtime_tmp);
							runtime_tmp = std::max(runtime_tmp, std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count());
							poke("stop" , time, runtime_tmp );
							NF_runtime.push_back(time);

							if (runtime_tmp-runtime_start > target_time) {
								GpiList remaining;
								for (++sit; sit!=started_indices.end(); ++sit) {
									remaining.push_back(*sit);
								}
								if (remaining.size()>0)								
									started_indices_out.push_back(remaining);
								break;
							}
						}
						if (measure_timings != 0) {
							runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_tmp, runtime_tmp-runtime_start, 1L});
						}
						//std::cout << runtime_start << ": EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-read port="singular_options" place="place_singular_options"/>
			<connect-read port="r" place="place_r"/>
			<connect-read port="syz_comp" place="place_syz_comp"/>
			<connect-read port="red_syz" place="place_red_syz"/>
			<connect-read port="target_time" place="place_target_time"/>
			<connect-read port="measure_timings" place="place_measure_timings"/>
			<connect-read port="M" place="place_M"/>
			<connect-in port="started_indices" place="place_started_indices"/>
			<connect-inout port="balNF" place="place_balNF"/>
			<connect-out-many port="started_indices_out" place="place_started_indices"/>
			<connect-out-many port="NF" place="place_NF"/>
			<connect-out-many port="NF_runtime" place="place_NF_runtime"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>



		<transition name="update_Q" priority="2">
			<defun>
				<properties name="gspc">
					<properties name="monitor">
						<properties name="color">
							<property key="started">
								"0x0000ff"
							</property>
							<property key="finished">
								"0x0000ff"
							</property>
							<property key="failed">
								"0xff0000"
							</property>
						</properties>
						<property key="tooltip">
						   "${tooltip.batch_size} := int(stack_size(${NF_list_input})); 
							${tooltip.nT_started_indices} := int(${nT_started_indices});
							${tooltip};"
						</property>
					</properties>
				</properties>
				<require key="update_Q" mandatory="true"/>
				<in name="nT_started_indices" type="unsigned long"/>
				<in name="nworkers" type="unsigned long"/>
				<in name="base_filename" type="string"/>
				<in name="installdir" type="string"/>
				<in name="degBounds" type="list"/>
				<in name="NF_list_input" type="list"/>
				<in name="r_in" type="int"/>
				<in name="blacklist" type="set"/>
				<in name="enable_update_Q_1" type="control"/>
				<in name="enable_update_Q_2" type="control"/>
				<in name="target_time" type="long"/>
				<in name="current_time" type="moving_avg"/>
				<in name="max_batch_size" type="long"/>
				<in name="head_size_factor" type="double"/>
				<in name="singular_options" type="bitset"/>
				<in name="syz_comp" type="long"/>
				<in name="red_syz" type="long"/>
				<in name="rank" type="int"/>
				<in name="measure_timings" type="long"/>
				<inout name="syzygy_indices" type="set"/>
				<inout name="n_syzygies" type="int"/>
				<inout name="M" type="list"/>
				<out name="update_r" type="list"/>
				<out name="enable_update_Q_2_out" type="list"/>
				<out name="update_job_queue" type="list"/>
				<out name="paused_indices" type="list"/>
				<out name="runtime" type="map"/>
				<out name="enable_get_NF_list" type="control"/>
				<out name="BB_finished" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_update_Q(paused_indices, NF_list_input, enable_get_NF_list, installdir, degBounds, runtime, base_filename, r_in, n_syzygies, syzygy_indices, update_r, enable_update_Q_2_out, M, BB_finished, blacklist, nT_started_indices, nworkers, update_job_queue, target_time, current_time, max_batch_size, head_size_factor, singular_options, syz_comp, red_syz, rank, measure_timings)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
						<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="fstream"/>
					<cinclude href="chrono"/>
					<cinclude href="thread"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[

					double runtime_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
					std::string singular_function_name = "update_Q";
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": START " << std::endl;
					//std::cout << "ENTERING " << singular_function_name << std::endl;
					std::string prot_str="";

					int r = r_in;
					GpiSet new_blacklist(blacklist);

					#ifdef DEBUG_BBA
					static int transition_count = 0;
					transition_count++;
					#endif
					
					//static GpiList Q = Q_in; 
					//static std::pair<sPairQueue,sPairQueue_by_indices> Q_Qind = deserialize_queue(base_filename+"queue/Q");
					static sPairQueue Q = deserialize_queue(base_filename+"queue/Q");
					static int lead_deg = -1;
					static int nsyzpairs = 0;
					//static std::set<int> syzygy_indices = {}; // only needed if red_syz is set
					//static sPairQueue_by_indices  Qind = Q_Qind.second;

					// add generators to a static variable, so each element will be read in only once per worker
					static std::list<poly> generators;
					//static_assert(sizeof(poly)==sizeof(void*));
					for (int k=generators.size()+1; k<=r; k++)
					{
						//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": reading generator " << k << std::endl;
						generators.emplace_back(RESOLVE_INTERFACE_FUNCTION(read_generator) (base_filename, k));
					}

					#ifdef DEBUG_BBA
					std::cout << runtime_start << ": ENTERING UPDATE_Q:  Q.size()="<<Q.size()<<", nT_started_indices="<<nT_started_indices<<", nworkers="<<nworkers<< std::endl;
					#endif

					// (A) initialize
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (A) initialize" << std::endl;
					long prodcrit_counter  = 0L;
					long diff_comp_counter = 0L;
					long chaincrit_counter = 0L;
					long degbound_counter  = 0L;
					long cancelled_element_counter = 0L;
					long cancelled_s_pair_counter  = 0L;

					std::set<std::pair<int,int> > zero_reductions = {};  //get_set(NF_list_input.at((int) 0));
					std::map<std::pair<int,int>,GpiVariant> NF_map = {};
					for(GpiList::const_iterator NF = NF_list_input.begin(); NF!=NF_list_input.end(); ++NF)
					{
						int i = boost::get<int>(peek("i",*NF)->get());
						int j = boost::get<int>(peek("j",*NF)->get());
						if (get_list(peek("lead_data",*NF)->get()).size()==0) // 0-reduction
						{
							zero_reductions.insert(std::make_pair(i,j));
						}
						else // non-0-reduction
						{
							NF_map[std::make_pair(i,j)] = *NF;
						}
					}

					GpiSet remove_from_running = {};

					#ifdef DEBUGFILE_BBA
					std::ofstream debugfile(base_filename+"debug.txt", std::ios::app);
					#endif

					// (B) build vector version of M
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (B) build vector version of M" << std::endl;
					std::vector<std::vector<std::vector<int> > > Mvec;
					for(GpiList::iterator Mi=M.begin(); Mi!=M.end(); ++Mi)
					{
						GpiList Mi_list = get_list(*Mi);
						std::vector<std::vector<int>> Mveci;
						for(GpiList::iterator Mii=Mi_list.begin(); Mii!=Mi_list.end(); ++Mii)
						{
							Mveci.emplace_back(list2vec(*Mii));
						}
						Mvec.emplace_back(Mveci);
					}


					// (C) remove from back of queue as long as possible
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (C) remove from back of queue as long as possible" << std::endl;
					int Qcounter=0;
					for (sPairQueue::const_iterator itQ = Q.begin(); itQ!=Q.end(); Qcounter++)
					{
						//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (0) init" << std::endl;
						GpiList new_lead;
						int old_r;
						
						int index_i = (itQ->first).first;
						int index_j = (itQ->first).second;
						std::map<std::pair<int,int>,GpiVariant>::const_iterator itNF = NF_map.find(itQ->first);
						if (itNF == NF_map.end())
						{
							if (zero_reductions.find(std::make_pair(index_i,index_j)) != zero_reductions.end())
				  // CASE 1: (i,j) reduced to 0: have to remove it from Q (will be done later, together with all the other 0-reductions)
							{
								//QUEUE std::cout << " (0) CASE 1" << std::endl;
								++itQ;
								--Qcounter;
								continue;
							}
							else
							{
								if ((itQ->second).old_r==r)
				  // CASE 2: element has reduced to non-0, was paused in earlier instance of the transition, but the reduction result is valid as it was carried out with the current number of generators
								{
									//QUEUE std::cout << " (0) CASE 2" << std::endl;
									old_r = (itQ->second).old_r;
									new_lead = (itQ->second).new_lead;
								}
								else {
				  // CASE 3: next element (i,j) in Q has not yet finished: break
									//QUEUE std::cout << " (0) CASE 3" << std::endl;
									break;
								}
							}

						}
						else
				  // CASE 4: (i,j) reduced to non-0
						{
							//QUEUE std::cout << " (0) CASE 4" << std::endl;
							new_lead = get_list(peek("lead_data",itNF->second)->get());
							old_r = boost::get<int>(peek("old_r",itNF->second)->get());
						}

				  // CASE 2 and 4: add new GB element (and remove (i,j) from Q)
						bool i_cancelled  = (blacklist.find(index_i)                   !=blacklist.end());
						bool j_cancelled  = (blacklist.find(index_j)                   !=blacklist.end());
						bool ij_excepted  = (blacklist.find(GpiSet ({index_i,index_j}))!=blacklist.end());
						bool ij_cancelled = (blacklist.find(GpiList({index_i,index_j}))!=blacklist.end());
						if (!(((i_cancelled || j_cancelled) && !ij_excepted) || (i_cancelled && j_cancelled) || ij_cancelled)) // test if s-pair (i,j) was excluded via chain criterion or a cancelled GB element (only needed in CASE 4)
						{
							// (1) test if the new element could be reduced further (only needed in CASE 4)
							//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (1) test if the new element could be reduced further" << std::endl;
							std::vector<int> new_lead_vec = list2vec(new_lead.front());
							bool abort = false;
							for(int ind=old_r; ind<r; ind++)
							{
								if(divides_monom(Mvec[ind][0],new_lead_vec))
								{
									#ifdef DEBUG_BBA
									std::cout << "M["<<ind<<"] divides lead, aborting" << std::endl;
									#endif
									abort = true;
									break;
								}
							}
							if (abort) {break;}

							#ifdef DEBUGFILE_BBA
							debugfile << "r:"<<r<<"->"<<r+1<<": adding new element due to s-pair ("<< index_i<<","<<index_j<<"), old_r="<<old_r<<" with new lead ";
							//debugfile << "r:"<<r<<"->"<<r+1<<": adding new element due to s-pair ("<< index_i<<","<<index_j<<") (old_r="<<old_r<<") with new lead ";
							//std::cout << " NEW ELEMENT DUE TO S-PAIR ("<<index_i<<","<<index_j<<") ---------------------------------------------------------------------------------------" << std::endl;
							#endif

							// (2) add new element to M and increase r
							//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (2) add new element to M and increase r" << std::endl;
							std::vector<std::vector<int>> Mvec_new;
							bool _first = true;
							for(GpiList::iterator Mi=new_lead.begin(); Mi!=new_lead.end(); ++Mi)
							{
								std::vector<int> new_entry = list2vec(*Mi);
								Mvec_new.emplace_back(new_entry);

								#ifdef DEBUGFILE_BBA
								if (_first)	{debugfile << "( ";
								for (int x : new_entry) {
									debugfile << x << " ";
								}
								debugfile << ")\n"; _first=false;}
								//debugfile << ") ";
								#endif
							}
							//debugfile << "]\n";

							Mvec.emplace_back(Mvec_new);
							M.push_back(new_lead);
							r++;

							#ifdef DEBUG_BBA
							std::cout << transition_count << ": added new element due to s-pair ("<<index_i<<","<<index_j<<"), new r=" << r << std::endl;
							#endif

							/* QUEUE
							auto Qentries = Q.get_entries();
							int count1 = 0;
							int count2 = 0;
							int max1 = 0;
							int max2 = 0;
							for (const auto& entry : Qentries) {
								if (entry.first.first == r) {
									count1++;
								}
								max1 = std::max(max1, entry.first.first);
								if (entry.first.second == r) {
									count2++;
								}
								max2 = std::max(max2, entry.first.second);
							}
							*/
							//QUEUE std::cout << "  (2)   r=" << r << ", count1=" << count1 << ", count2=" << count2 << ", max1=" << max1 << ", max2=" << max2 << std::endl;


							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": M.size()="<<M.size()<<", increasing r from " << r-1 << " to " << r << " due to spoly (" << index_i << "," << index_j << "),  new lead:           -------------------------"<< std::endl;
							print_variant(new_lead);
							#endif

							// (3) save file containing the new GB element
							//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (3) save file containing the new GB element" << std::endl;
							std::string save_filename = base_filename+"temporary_files/intermediate_result_"+std::to_string(index_i)+"_"+std::to_string(index_j);

							//QUEUE std::cout << runtime_start << ": reading new generator from " << save_filename << ", red_tail=" << (singular_options.is_element(REDTAIL) ? "true" : "false") << std::endl;
							if (singular_options.is_element(REDTAIL) && false)
								RESOLVE_INTERFACE_FUNCTION(tail_reduce) (&generators, singular_options, save_filename, base_filename + "intermediate_files/f"+std::to_string(r)); // NF_spoly can't be reduced further, so just rename its file to the new generator
							else 
								std::rename(save_filename.c_str(), (base_filename + "intermediate_files/f"+std::to_string(r)).c_str()); // NF_spoly can't be reduced further, so just rename its file to the new generator
							//QUEUE std::cout << runtime_start << ": done! " << std::endl;
							
							int r_is_syzygy = 0;
							if (red_syz>0 && syz_comp>0 && Mvec_new[0].back()>syz_comp) {
								syzygy_indices.insert(r); //mark indices that refer to syzygies
								r_is_syzygy = 1;
							}
							
							
							// (4) add to Q or exclude (PC/CC) new s-pairs involving the new element
							//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (4) add to Q or exclude (PC/CC) new s-pairs involving the new element" << std::endl;
							bool skip_syzygy_spairs = red_syz==1 && syz_comp>0;
							std::vector<std::vector<int>> Mr = Mvec.back();
							int i=1;
							bool first=true;
							if (skip_syzygy_spairs && r_is_syzygy)
							{
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<r; ++Mi, i++)
								{
									if (syzygy_indices.find(i)!=syzygy_indices.end() && divides_monom(Mr[0],(*Mi)[0])) 
									{
										// new lead (a syzygy) divides i-th lead (also a syzygy) ==> reduce i-th element further 
										std::cout << "found syzygy with dividing lead ("<<r<<" divides "<<i<<")" << std::endl;
										std::vector<int> lcm_i_r = lcm((*Mi)[0], Mr[0]);
										//QUEUE std::cout << " (4) queue_insert (syz) before: entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
										queue_insert(Q, i, r, (int) 0, *Mi, Mr, lcm_i_r, false);
										nsyzpairs++;
										//QUEUE std::cout << " (4) queue_insert (syz) after:  entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
									}
								}
							}
							else
							{
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<r; ++Mi, i++)
								{
									int i_is_syzygy = syzygy_indices.find(i)!=syzygy_indices.end() ? 1 : 0;
									if (skip_syzygy_spairs && i_is_syzygy) 
									{
										continue;
									}

									bool add_to_Q = true;
									bool PC = false;
									std::vector<int> lcm_i_r;

									if (blacklist.find((GpiVariant) i) != blacklist.end())
									{
										add_to_Q = false;
									}
									else
									{
										lcm_i_r = lcm((*Mi)[0], Mr[0]);
										if (over_deg_bound(lcm_i_r, degBounds)) // apply degree bound
										{
											add_to_Q=false;
											degbound_counter++;
											//FIX: std::ofstream ijFile(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
										}
										int PC_res = test_PC((*Mi)[0],Mr[0],rank); // 1: PC positive,  2: different lead components,  0: else
										if (PC_res!=0) // apply PC
										{
											add_to_Q = false;
											if (PC_res==1) {
												prodcrit_counter++;
												//FIX: std::ofstream ijFile(base_filename+"queue/product_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
											}
											else {
												diff_comp_counter++;
												//FIX: std::ofstream ijFile(base_filename+"queue/different_component/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
											}

											if(syz_comp>0 && PC_res==1) {
												add_to_Q = true;
												PC = true;
												// make NF_of_spoly construct the syzygy instead
											}
										}
										else // apply CC
										{
											int k=1;
											for (std::vector<std::vector<std::vector<int> > >::iterator Mk=Mvec.begin(); k<=r; ++Mk, k++)
											{
												if(k!=i && k!=r)
												{
													if (test_CC(lcm_i_r, (*Mi)[0], Mr[0], (*Mk)[0]))
													{
														if(k<i)
														{
															add_to_Q = false;
															chaincrit_counter++;
															//FIX: std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
															break;
														}
														else // thus i<k<r  (k>r is not possible)
														{
															std::vector<int> lcm_k_r = lcm((*Mk)[0], Mr[0]);
															if(!equal(lcm_k_r,lcm_i_r))
															{
																add_to_Q = false;
																chaincrit_counter++;
																//FIX: std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
																break;
															}
														}
													}
												}
											}
										}
									}

									if (divides_monom(Mr[0],(*Mi)[0]) &&  (blacklist.find((GpiVariant) i)==blacklist.end()))
									{
										// new found lead monomial divides i-th lead monomial ==> put i in blacklist
										// (and Set(i,r) as the (i,r)-th spoly has to be reduced, it is not eliminated through CC!)
										new_blacklist.emplace(i);
										new_blacklist.emplace(GpiSet({i,r}));
										// remove (i,j) for all j from Q:
										//QUEUE std::cout << " (4) queue_delete_i (cancelled_element) before: entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
										queue_delete_i(Q, i, r, "cancelled_element", &nsyzpairs, i_is_syzygy);
										//QUEUE std::cout << " (4) queue_delete_i (cancelled_element) after:  entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
										cancelled_element_counter++;
									}

									if(add_to_Q)
									{
										//QUEUE std::cout << " (4) queue_insert (end) before: entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
										queue_insert(Q, i, r, (int) 0, *Mi, Mr, lcm_i_r, PC);
										if (i_is_syzygy)
											nsyzpairs++;
										//QUEUE std::cout << " (4) queue_insert (end) after:  entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
									}
								}

								// (5) remove old s-pairs due to chain condition
								//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (5) remove old s-pairs due to chain condition" << std::endl;
								for (sPairQueue::iterator Qk=Q.begin(); Qk!=Q.end(); )
								{
									//int ii = boost::get<int>(get_list(*Qk).front());
									//int jj = boost::get<int>(*std::next(get_list(*Qk).begin()));
									int ii = (Qk->first).first;
									int jj = (Qk->first).second;

									std::vector<int> lcm_i_j = lcm(Mvec[ii-1][0],Mvec[jj-1][0]);

									if(test_CC(lcm_i_j, Mvec[ii-1][0], Mvec[jj-1][0], Mvec[r-1][0]))
									{
										std::vector<int> lcm_i_r = lcm(Mvec[ii-1][0], Mvec[r-1][0]);
										std::vector<int> lcm_j_r = lcm(Mvec[jj-1][0], Mvec[r-1][0]);
										if(!equal(lcm_i_r,lcm_i_j) && !equal(lcm_j_r,lcm_i_j))
										{
											#ifdef DEBUGFILE_BBA
											if (first)  {
												debugfile << "CC: removing indices ";
												first = false;
											}
											#endif
											new_blacklist.emplace(GpiList({ii,jj}));
											Qk = Q.erase(Qk);
											nsyzpairs -= (syzygy_indices.find(ii)!=syzygy_indices.end() ? 1 : 0);
											//Qind.erase(std::make_pair(ii,jj));
											chaincrit_counter++;
											cancelled_s_pair_counter++;
											//FIX: std::remove((base_filename+"queue/started/"+std::to_string(std::min(ii,jj))+"_"+std::to_string(std::max(ii,jj))).c_str());
											//FIX: std::ofstream ijFile(base_filename+"queue/cancelled_s_pair/"+std::to_string(std::min(ii,jj))+"_"+std::to_string(std::max(ii,jj))); ijFile.close();
											#ifdef DEBUGFILE_BBA
											debugfile << "("<<ii<<","<<jj<<","<<(Qk->second).old_r<<") ";
											#endif
										}
										else {++Qk;}
									}
									else {++Qk;}
								}
							}


							#ifdef DEBUGFILE_BBA
							if (!first) debugfile << "\n";
							#endif
						}


						// (6) remove from front of Q and advance to next element
						//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (6) remove from front of Q and advance to next element" << std::endl;
						remove_from_running.insert(GpiList({index_i,index_j}));
						//QUEUE std::cout << " (6) 1" << std::endl;
						//QUEUE std::cout << " (6) 2 queue_delete_i_j (new_element) before: entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
						itQ = queue_delete_i_j(Q, index_i, index_j, "new_element", &nsyzpairs, syzygy_indices.find(index_i)!=syzygy_indices.end() ? 1 : 0);
						//QUEUE std::cout << " (6) 2 queue_delete_i_j (new_element) after:  entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
						//QUEUE std::cout << "     itQ==Q.end()" << (itQ==Q.end() ? "true" : "false") << std::endl;
						//QUEUE std::cout << " (6) 3" << std::endl;
						if (singular_options.is_element(PROT)) {
							//QUEUE std::cout << " (6) 4" << std::endl;
							//QUEUE std::size_t Q_size1 = Q.entries_size();
							//QUEUE std::cout << " (6) 5  entries:" << Q_size1 << std::endl;
							//QUEUE std::size_t Q_size2 = Q.references_size();
							//QUEUE std::cout << " (6) 6  entries:" << Q_size1 << ", references:" << Q_size2 << std::endl;
							std::size_t Q_size = Q.size();
							//QUEUE std::cout << " (6) 7  Q_size=" << Q_size << std::endl;
							prot_str = prot_str + "s(" + std::to_string(Q_size) + ")";
							//QUEUE std::cout << " (6) 8" << std::endl;
							if (Q_size>0 && lead_deg != Q.front_value().deg_lcm) {
								//QUEUE std::cout << " (6) 9" << std::endl;
								lead_deg = Q.front_value().deg_lcm;
								//QUEUE std::cout << " (6) 10" << std::endl;
								prot_str = prot_str + std::to_string(lead_deg);
								//QUEUE std::cout << " (6) 11" << std::endl;
							}
						}
						//QUEUE std::cout << " (6) 12" << std::endl;

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": increment: set size of Q(ueue) to " << Q.size() <<std::endl;
						#endif
					}

					#ifdef DEBUG_BBA
					std::cout << "added "<<Qcounter<<" elements from the back of the Q(ueue)" << std::endl;
					#endif


					// (D) update old_r in the Queue for other non-0-reductions (to be started again later via start_jobs):
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (D) update old_r in the Queue for other non-0-reductions" << std::endl;
					bool first=true;
					for (std::map<std::pair<int,int>,GpiVariant>::const_iterator itNF=NF_map.begin(); itNF!=NF_map.end(); ++itNF)
					{
						int index_i = itNF->first.first;
						int index_j = itNF->first.second;
						GpiList ij_list = {index_i,index_j};
						if(remove_from_running.find(ij_list)==remove_from_running.end()) // && (itNF->first).which()!=2)
						{
							#ifdef DEBUGFILE_BBA
							if (first) {
								debugfile << "pausing s-pairs: ";
								first = false;
							}
							debugfile <<"("<<index_i<<","<<index_j<<","<<boost::get<int>(peek("old_r",itNF->second)->get())<<") ";
							#endif

							remove_from_running.insert(ij_list);
							//QUEUE std::cout << " (D) queue_mark_paused_i_j before: entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
							queue_mark_paused_i_j(Q, index_i, index_j, itNF->second);
							//QUEUE std::cout << " (D) queue_mark_paused_i_j after:  entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;

						}
					}
					#ifdef DEBUGFILE_BBA
					if (!first)	debugfile << "\n";
					#endif


					// (E) remove 0-reductions from the queue
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (E) remove 0-reductions from the queue" << std::endl;
					first=true;
					for (std::set<std::pair<int,int> >::const_iterator itNF0=zero_reductions.begin(); itNF0!=zero_reductions.end(); ++itNF0)
					{
						#ifdef DEBUGFILE_BBA
						if (first) {
							debugfile << "reduced to 0: ";
							first = false;
						}
						#endif
						int index_i = itNF0->first;
						int index_j = itNF0->second;
						remove_from_running.insert(GpiList({index_i,index_j}));
						//QUEUE std::cout << " (E) queue_delete_i_j (zero_reduction) before: entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;
						bool deleted;
						queue_delete_i_j(Q, index_i, index_j, "zero_reduction", &nsyzpairs, syzygy_indices.find(index_i)!=syzygy_indices.end() ? 1 : 0, &deleted);
						//QUEUE std::cout << " (E) queue_delete_i_j (zero_reduction) after:  entries:" << Q.entries_size() << ", references:" << Q.references_size() << ", EQUAL:" << (Q.entries_size()==Q.references_size() ? "TRUE" : "FALSE") << std::endl;

						if(syz_comp>0 && red_syz==0) {  // save file containing the new syzygy (if red_syz>0 this will be done later)
						std::string syz_filename = base_filename+"temporary_files/intermediate_result_"+std::to_string(index_i)+"_"+std::to_string(index_j);
							if(!std::rename(syz_filename.c_str(), (base_filename + "result/s"+std::to_string(n_syzygies+1)).c_str())) 	//just rename its file to the new syzygy
								n_syzygies++;
						}

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": remove_from_Q: removed element (" << index_i << "," << index_j << ") from Q(ueue) as it reduced to 0, size of Q: " << Q.size() <<std::endl;
						#endif
						if (singular_options.is_element(PROT) && deleted) {
							prot_str = prot_str + "-";
							int Q_size = Q.size();
							if (Q_size>0 && Q_size%100==0) // || (Q_size<100 && Q_size%10==0))
							{
								prot_str = prot_str + "(" + std::to_string(Q_size) + ")";
							}
							if (Q_size>0 && lead_deg != Q.front_value().deg_lcm) {
								lead_deg = Q.front_value().deg_lcm;
								prot_str = prot_str + std::to_string(lead_deg);
							}
						}

					}
					#ifdef DEBUGFILE_BBA
					if (!first)	debugfile << "\n";
					#endif

					// (F) update LOG.txt:
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (F) update LOG.txt" << std::endl;
					std::ofstream logFile(base_filename+"LOG.txt");
					logFile << "Gröbner Basis:\n";
					logFile << " GB: " << r-syzygy_indices.size() << "\n";
					logFile << "syz: " <<   syzygy_indices.size() << "\n";
					logFile << "Queue of s-pairs:\n";
					logFile << " GB: " << Q.size()-nsyzpairs << "\n";
					logFile << "syz: " <<   		nsyzpairs;
					logFile.close();

					if (singular_options.is_element(PROT)) {
						//std::cout << prot_str << std::endl;
						std::ofstream prot_file(base_filename+"prot.txt", std::ios::app);
						prot_file << prot_str;
						prot_file.close();
					}


					// (G) termination condition + update of the r and blacklist places
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (G) termination condition + update of the r and blacklist places" << std::endl;
					//if (new_blacklist.size()>blacklist.size()) std::cout << "blacklist size: " << blacklist.size() << ", new_blacklist size: " << new_blacklist.size() << std::endl;
					if(Q.size()>0)
					{
						if (r>r_in || new_blacklist.size()>0)
						{
							GpiVariant new_values;
							poke("first" , new_values, r);
							poke("second", new_values, new_blacklist);
							update_r.push_back(new_values);
						}
						else {
							enable_update_Q_2_out.push_back(CONTROL_TOKEN); // skip update_r transition and directly enable update_Q_2, as r has not increased and no new elements have been blacklisted
						}

					}
					else // queue empty ==> terminate Buchberger algorithm
					{
						std::cout << "########################################## Buchberger Algorithm finished ##########################################" << std::endl;
						BB_finished.emplace_back(CONTROL_TOKEN);
					}


					// (H) start jobs:
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (H) start jobs" << std::endl;
					update_job_queue = GpiList({remove_from_running});
					#ifdef DEBUGFILE_BBA
					debugfile << "remove from running: ";
					for(GpiSet::const_iterator it=remove_from_running.begin(); it!=remove_from_running.end(); ++it) {
						debugfile <<"("<<boost::get<int>(get_list(*it).front())<<","<<boost::get<int>(get_list(*it).back())<<") ";
					}
					debugfile << "\n";
					#endif
					//for(sPairQueue::iterator entry=Q.begin(); entry!=Q.hend(); ++entry)
					first=true;
					int insert_counter=0;

					long batch_size = static_cast<long>(std::llround(static_cast<double>(target_time)/current_time.avg));
					batch_size = std::min(batch_size, max_batch_size);
					batch_size = std::max(batch_size, 1L);
					long head_size = batch_size * nworkers * head_size_factor;
					//std::cout << "\nBUILDING JOB QUEUE" << std::endl;
					for(sPairQueue::iterator entry=Q.begin(); insert_counter<head_size &&  entry!=Q.end(); ++entry)
					{
						#ifdef DEBUGFILE_BBA
						if (first) {
							debugfile << "starting jobs: ";
							first = false;
						}
						#endif
						std::pair<int,int> indices = entry->first;
						int old_r = (entry->second).old_r;
						bool PC = (entry->second).PC;
						if (old_r>=r) {continue;} // withhold s-pair from the job-queue until r has increased!

						#ifdef DEBUG_BBA
						std::cout << "adding " << indices.first << "," << indices.second << " (old_r="<<old_r<<") to update_job_queue, syzygy=(" << (syzygy_indices.find(indices.first)!=syzygy_indices.end() ? 1 : 0) << "," << (syzygy_indices.find(indices.second)!=syzygy_indices.end() ? 1 : 0) << "), PC: " << (PC ? 1 : 0) << std::endl;
						#endif
						#ifdef DEBUGFILE_BBA
						debugfile <<"("<<indices.first<<","<<indices.second<<","<<old_r<<") ";
						#endif


						update_job_queue.emplace_back(GpiList({indices.first, indices.second, old_r, (int) (PC ? 2 : (syzygy_indices.find(indices.first)!=syzygy_indices.end() ? 1 : 0))}));
						insert_counter++;
					}
					#ifdef DEBUGFILE_BBA
					if (!first)	debugfile << "\n";

					// current Queue:
					debugfile << "\n";
					displayQ(Q, debugfile);
					debugfile << "\n\n";
					debugfile.close();
					#endif


					// (I) runtime (and other) measurements
					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": (I) runtime" << std::endl;
					double runtime_stop = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
					if (measure_timings != 0) {
						runtime[(std::string) "PRODUCT CRITERION"] = GpiList({-1.0, -1.0, -1.0,  prodcrit_counter});
						runtime[(std::string) "DIFFERENT COMPONENT"] = GpiList({-1.0, -1.0, -1.0,  diff_comp_counter});
						runtime[(std::string) "CHAIN CRITERION"] = GpiList({-1.0, -1.0, -1.0, chaincrit_counter});
						runtime[(std::string) "DEGREE BOUND"] = GpiList({-1.0, -1.0, -1.0, degbound_counter});
						runtime[(std::string) "CANCELLED ELEMENTS"] = GpiList({-1.0, -1.0, -1.0,  cancelled_element_counter});
						runtime[(std::string) "CANCELLED S-PAIRS"] = GpiList({-1.0, -1.0, -1.0,  cancelled_s_pair_counter});
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});
					}

					//QUEUE std::cout << runtime_start << ": " << singular_function_name << ": STOP " << std::endl;
					//std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-number-of-tokens port="nT_started_indices" place="place_started_indices"/>
			<connect-read port="nworkers" place="place_nworkers"/>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<connect-read port="degBounds" place="place_degBounds"/>
			<connect-read port="r_in" place="place_r"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-read port="target_time" place="place_target_time"/>
			<connect-read port="current_time" place="place_current_time"/>
			<connect-read port="max_batch_size" place="place_max_batch_size"/>
			<connect-read port="head_size_factor" place="place_head_size_factor"/>
			<connect-read port="singular_options" place="place_singular_options"/>
			<connect-read port="syz_comp" place="place_syz_comp"/>
			<connect-read port="red_syz" place="place_red_syz"/>
			<connect-read port="rank" place="place_rank"/>
			<connect-read port="measure_timings" place="place_measure_timings"/>
			<connect-in port="NF_list_input" place="place_NF_list_input"/>
			<connect-in port="enable_update_Q_1" place="place_enable_update_Q_1"/>
			<connect-in port="enable_update_Q_2" place="place_enable_update_Q_2"/>
			<connect-inout port="n_syzygies" place="place_n_syzygies"/>
			<connect-inout port="syzygy_indices" place="place_syzygy_indices"/>
			<connect-inout port="M" place="place_M"/>
			<connect-out port="runtime" place="place_runtime"/>
			<connect-out port="update_job_queue" place="place_update_job_queue"/>
			<connect-out port="enable_get_NF_list" place="place_enable_get_NF_list"/>
			<connect-out-many port="update_r" place="place_update_r"/>
			<connect-out-many port="enable_update_Q_2_out" place="place_enable_update_Q_2"/>
			<connect-out-many port="paused_indices" place="place_paused_indices"/>
			<connect-out-many port="BB_finished" place="place_BB_finished"/>
		</transition>



		<transition name="update_job_queue">
			<defun>
				<require key="update_job_queue" mandatory="true"/>
				<in name="update_job_queue" type="list"/>
				<in name="nT_started_indices" type="unsigned long"/>
				<in name="nT_paused_indices" type="unsigned long"/>
				<inout name="job_queue_running" type="set"/>
				<inout name="job_queue" type="list"/>
				<out name="enable_update_Q_1" type="control"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="update_job_queue(enable_update_Q_1, job_queue_running, update_job_queue, job_queue, nT_started_indices, nT_paused_indices)">
					<cinclude href="interface/buchberger_interface.hpp"/>
						<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[
					//std::cout << "ENTERING update_job_queue" << std::endl;

						#ifdef DEBUG_BBA
						std::cout << "update_job_queue: update          : " << joblist_to_string(update_job_queue) << std::endl;
						std::cout << "update_job_queue: remove          : " << joblist_to_string(get_set(update_job_queue.front())) << std::endl;
						std::cout << "update_job_queue: running   before: " << joblist_to_string(job_queue_running) << std::endl;
						std::cout << "update_job_queue: job_queue before: " << joblist_to_string(job_queue) << std::endl;
						#endif

						GpiList::const_iterator it=update_job_queue.begin();
						GpiSet remove_from_running = get_set(*it); ++it;
						for (GpiSet::const_iterator it2=remove_from_running.begin(); it2!=remove_from_running.end(); ++it2)
						{
							/*
							GpiList NF = get_list(*it2);
							GpiList::const_iterator it = NF.begin();
							int i = boost::get<int>(*it2); ++it2;
							int j = boost::get<int>(*it2);
							job_queue_running.erase(GpiList({i,j}));
							*/
							job_queue_running.erase(*it2);
						}

						job_queue = GpiList({});

						for (; it!=update_job_queue.end(); ++it) {
							GpiList::const_iterator itt = get_list(*it).begin();
							int i = boost::get<int>(*itt); ++itt;
							int j = boost::get<int>(*itt);
							if (job_queue_running.find(GpiList({i,j}))==job_queue_running.end()) { //## makes sure, no computation is started twice. Could this be removed?
								job_queue.emplace_back(*it);
							}
						}

						#ifdef DEBUG_BBA
						std::cout << "update_job_queue: running    after: " << joblist_to_string(job_queue_running) << std::endl;
						std::cout << "update_job_queue: job_queue  after: " << joblist_to_string(job_queue) << std::endl;
						std::cout << "nT_started_indices="<<nT_started_indices<<", nT_paused_indices="<<nT_paused_indices << std::endl;
						#endif

						//std::cout << "EXITING update_job_queue" << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-number-of-tokens port="nT_started_indices" place="place_started_indices"/>
			<connect-number-of-tokens port="nT_paused_indices" place="place_paused_indices"/>
			<connect-in port="update_job_queue" place="place_update_job_queue"/>
			<connect-inout port="job_queue_running" place="place_job_queue_running"/>
			<connect-inout port="job_queue" place="place_job_queue"/>
			<connect-out port="enable_update_Q_1" place="place_enable_update_Q_1"/>
		</transition>



		<transition name="start_jobs">
			<defun>
				<require key="start_jobs" mandatory="true"/>
				<in name="nworkers" type="unsigned long"/>
				<in name="nT_started_indices" type="unsigned long"/>
				<in name="r" type="int"/>
				<in name="max_batch_size" type="long"/>
				<in name="target_time" type="long"/>
				<in name="current_time" type="moving_avg"/>
				<inout name="job_queue" type="list"/>
				<inout name="job_queue_running" type="set"/>
				<out name="started_indices" type="list"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="start_jobs(job_queue_running, job_queue, started_indices, nT_started_indices, nworkers, r, max_batch_size, target_time, current_time)">
					<cinclude href="interface/buchberger_interface.hpp"/>
						<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[
						//std::cout << "ENTERING start_jobs (nrunning="<<nT_started_indices<<", nworkers="<<nworkers<<")" << std::endl;

						unsigned long nrunning = nT_started_indices;


						long batch_size = static_cast<long>(std::llround(static_cast<double>(target_time)/current_time.avg));
						batch_size = std::min(batch_size, static_cast<long>(job_queue.size()/(nworkers-nrunning)));
						batch_size = std::min(batch_size, max_batch_size);
						batch_size = std::max(batch_size, 1L);

						#ifdef DEBUG_BBA
						std::cout << "nrunning: " <<nrunning<< ", nworkers: " <<nworkers<<  ", batch_size: " <<batch_size<<  ", current_time: " <<current_time.avg<< std::endl;
						std::cout << "start_jobs: job_queue before: " << joblist_to_string(job_queue) << std::endl;
						//print_variant(job_queue);
						#endif

						//while (job_queue.size()>0 && nrunning*2<nworkers*3) {
						while (job_queue.size()>0 && nrunning < nworkers) { // only have as many jobs running as there are NF_of_spoly transitions
							GpiList batch = {};
							for(int ind=0; ind<batch_size && job_queue.size()>0; ind++) {
								GpiList job = get_list(job_queue.front());
								GpiList::const_iterator it = job.begin();
								int i	   = boost::get<int>(*it); ++it;
								int j      = boost::get<int>(*it); ++it;
								int old_r  = boost::get<int>(*it); ++it;
								int syzygy = boost::get<int>(*it);

								GpiVariant si;
								poke("i"     , si, i);
								poke("j"     , si, j);
								poke("old_r" , si, old_r);
								poke("syzygy", si, syzygy);
								batch.push_back(si);

								#ifdef DEBUG_BBA
								std::cout << " start_jobs: adding ("<<i<<","<<j<<","<<old_r<<","<<syzygy<<") to started_indices" << std::endl;
								#endif
								// add (i,j) to started indices:
								job_queue_running.insert(GpiList({i,j}));
								job_queue.pop_front();
							}
							nrunning++;
							started_indices.push_back(batch);
						}

						#ifdef DEBUG_BBA
						std::cout << "start_jobs: job_queue after: " << joblist_to_string(job_queue) << std::endl;
						//print_variant(job_queue);
						#endif

						//std::cout << "EXITING start_jobs" << std::endl;
						//((stack_size(${job_queue}) :gt: 0UL) :and: (${nT_started_indices}*2UL :lt: ${nworkers}*3UL))
						//                             :and: (${nT_started_indices} :lt: ${nworkers})

					]]></code>
				</module>
			</defun>
			<condition>
				((stack_size(${job_queue}) :gt: 0UL) :and: (${nT_started_indices} :lt: ${nworkers}))
			</condition>
			<connect-read port="nworkers" place="place_nworkers"/>
			<connect-read port="r" place="place_r"/>
			<connect-read port="max_batch_size" place="place_max_batch_size"/>
			<connect-read port="target_time" place="place_target_time"/>
			<connect-read port="current_time" place="place_current_time"/>
			<connect-number-of-tokens port="nT_started_indices" place="place_started_indices"/>
			<connect-inout port="job_queue" place="place_job_queue"/>
			<connect-inout port="job_queue_running" place="place_job_queue_running"/>
			<connect-out-many port="started_indices" place="place_started_indices"/>
		</transition>



		<transition name="update_r" priority="1">
			<defun>
				<!--require key="misc" mandatory="true"/-->
				<in name="update_r_bl" type="pair__int__set"/>
				<inout name="r" type="int"/>
				<inout name="blacklist" type="set"/>
				<out name="enable_update_Q_2" type="control"/>
				<expression>
					${r}         := ${update_r_bl.first};
					${blacklist} := ${update_r_bl.second};
					${enable_update_Q_2} := [];
				</expression>
				<!--module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="update_r(update_r_bl, r, blacklist, enable_update_Q_2)">
					<cinclude href="interface/buchberger_interface.hpp"/>
						<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[

						r     = update_r_bl.first;
						blacklist = update_r_bl.second;
						//blacklist.insert(update_r_bl.second.begin(), update_r_bl.second.end());
						enable_update_Q_2 = CONTROL_TOKEN;

					]]></code>
				</module-->
			</defun>
			<connect-in port="update_r_bl" place="place_update_r"/>
			<connect-inout port="r" place="place_r"/>
			<connect-inout port="blacklist" place="place_blacklist"/>
			<connect-out port="enable_update_Q_2" place="place_enable_update_Q_2"/>
		</transition>



		<transition name="collect_NF"> <!-- temporary, will be replaced by an in-many connection -->
			<defun>
				<!--require key="collect_NF" mandatory="true"/-->
				<in name="NF" type="reduction_result"/>
				<inout name="NF_list" type="list"/>
				<expression>
					${NF_list} := stack_push(${NF_list}, ${NF})
				</expression>
			</defun>
			<connect-in port="NF" place="place_NF"/>
			<connect-inout port="NF_list" place="place_NF_list"/>
		</transition>



		<transition name="get_NF_list"> <!-- temporary, will be replaced by an in-many connection -->
			<defun>
				<!--require key="get_NF_list" mandatory="true"/-->
				<in name="enable_get_NF_list" type="control"/>
				<in name="nT_NF" type="unsigned long"/>
				<inout name="NF_list" type="list"/>
				<out name="NF_list_input" type="list"/>
				<expression>
					${NF_list_input} := ${NF_list};
					${NF_list} := List ();
				</expression>
				<!--module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="get_NF_list(NF_list, NF_list_input)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[
						//std::cout << "ENTERING get_NF_list" << std::endl;
						NF_list_input = NF_list;
						NF_list = GpiList({});
						//std::cout << "EXITING get_NF_list" << std::endl;
					]]></code>
				</module-->
			</defun>
			<condition>
				(stack_size(${NF_list}) :gt: 0UL) :and: (${nT_NF} :eq: 0UL)
			</condition>
			<connect-in port="enable_get_NF_list" place="place_enable_get_NF_list"/>
			<connect-number-of-tokens port="nT_NF" place="place_NF"/>
			<connect-inout port="NF_list" place="place_NF_list"/>
			<connect-out port="NF_list_input" place="place_NF_list_input"/>
		</transition>



		<transition name="average_NF_runtime">
			<defun>
				<in name="mv_avg_base" type="double"/>
				<in name="NF_runtime" type="timing"/>
				<inout name="current_time" type="moving_avg"/>
				<!-->
				${new_start} := max( ${current_time.start} , ${NF_runtime.start} );
				${factor} := pow( ${mv_avg_base} , tolong( ${current_time.start} - ${new_start} ) );
				${weight} := pow( ${mv_avg_base} , tolong( ${NF_runtime.start}   - ${new_start} ) );
				${current_time.count} := ( ${current_time.count} * ${factor} ) + ${weight};
				${current_time.total} := ( ${current_time.total} * ${factor} ) + ( ${weight} * ( ${NF_runtime.stop} - ${NF_runtime.start} ) );
				${current_time.start} := ${new_start};
				${current_time.avg} := div( ${current_time.total} , ${current_time.count} );
				<-->
				<expression>
					${current_time.avg} := ( 0.95 * ${current_time.avg} ) + ( 0.05 *( ${NF_runtime.stop} - ${NF_runtime.start} ) );
				</expression>
			</defun>
			<connect-read port="mv_avg_base" place="place_mv_avg_base"/>
			<connect-in port="NF_runtime" place="place_NF_runtime"/>
			<connect-inout port="current_time" place="place_current_time"/>
		</transition>



		<transition name="minimize_GB" priority="1">
			<defun>
				<require key="misc" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="installdir" type="string"/>
				<in name="singular_options" type="bitset"/>
				<in name="syz_comp" type="long"/>
				<in name="red_syz" type="long"/>
				<in name="measure_timings" type="long"/>
				<in name="BB_finished" type="control"/>
				<in name="M" type="list"/>
				<in name="r" type="int"/>
				<in name="job_queue" type="list"/>
				<in name="syzygy_indices" type="set"/>
				<inout name="n_syzygies" type="int"/>
				<out name="generator_indices" type="list"/>
				<out name="needed_indices" type="list"/>
				<out name="output" type="string"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_minimize_GB(runtime, base_filename, installdir, singular_options, M, n_syzygies, generator_indices, needed_indices, output, syzygy_indices, syz_comp, red_syz, measure_timings)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="filesystem"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
						//std::cout << "ENTERING minimize_GB" << std::endl;
						double runtime_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						int r=M.size();

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": minimizing Gröbner basis with initially " << r << " elements (of which: "<<syzygy_indices.size()<<" syzygies)" << std::endl;
						std::cout << runtime_start << ": lead monomials:" << std::endl;

						print_variant(M);
						#endif
						std::vector<std::vector<std::vector<int> > > Mvec;
						for(GpiList::const_iterator Mi=M.begin(); Mi!=M.end(); ++Mi)
						{
							GpiList Mi_list = get_list(*Mi);
							std::vector<std::vector<int>> Mveci;
							for(GpiList::iterator Mii=Mi_list.begin(); Mii!=Mi_list.end(); ++Mii)
							{
								Mveci.emplace_back(list2vec((*Mii)));
							}
							Mvec.emplace_back(Mveci);
						}


						bool needed;
						int si1=1;
						int si2=1;
						for(int i=0; i<r; i++)
						{
							/*
							if(red_syz==1 && syz_comp>0 && syzygy_indices.find(i+1)!=syzygy_indices.end()) {
								std::string syz_filename = base_filename + "intermediate_files/f"+std::to_string(i+1);
								std::filesystem::copy_file(
								    syz_filename, (base_filename + "result/s"+std::to_string(n_syzygies+1)),
								    std::filesystem::copy_options::overwrite_existing
								);
								//std::filesystem::rename(syz_filename.c_str(), (base_filename + "result/s"+std::to_string(n_syzygies+1)).c_str()); 	//just rename its file to the new syzygy
								generator_indices.emplace_back((long) (i+1));
								n_syzygies++;
								continue;
							}
							*/
							needed = true;
							for(int j=0; j<r; j++) {
								if(j!=i) {
								if(divides_monom(Mvec[j][0],Mvec[i][0])) {
									if(i<j || !(equal(Mvec[i][0],Mvec[j][0]))) {
										needed = false; break;
								}}}
							}
							if(needed)
							{
								generator_indices.emplace_back((long) (i+1));

								GpiVariant needed_index;
								poke("generator", needed_index, i+1);  // name of generator file to read from (f1,f2,...)
								poke("generator_index", needed_index, si1+si2-2); // index of that generator in the list of needed reducers
								if((red_syz==1 || red_syz==2) && syz_comp>0 && syzygy_indices.find(i+1)!=syzygy_indices.end()) {
									n_syzygies++;
									poke("save_index"     , needed_index, si1); // name the result will be saved as (s1,s2,...)
									poke("is_syzygy"      , needed_index, 1);
									si1++;
								}
								else {
									poke("save_index"     , needed_index, si2); // name the result will be saved as (g1,g2,...)
									poke("is_syzygy"      , needed_index, 0);
									si2++;
								}
								needed_indices.emplace_back(needed_index);
							}
						}
						int final_r = si2-1; //size(needed_indices);

						if (singular_options.is_element(PROT) && singular_options.is_element(REDSB)) {
							std::ofstream prot_file(base_filename+"prot.txt", std::ios::app);
							prot_file << "\n(S:" << final_r << ")";
							prot_file.close();
						}
						
						GpiBigint bigint_test=2;
						bigint_test=pow(bigint_test,130);
						//std::cout << "before: " << bigint_test << std::endl;

						std::vector<boost::variant<long,std::string,GpiList,GpiBigint>>  args_read, args_in;  std::vector<boost::variant<long*,std::string*,GpiList*,GpiBigint*>>  args_inout, out;  std::vector<GpiList*>  out_many;
						std::string singular_function_name = "minimize_GB";
						//std::string library_name = base_filename.substr(0, base_filename.find_last_of('/', base_filename.size() - 2) + 1) + "buchbergergp.lib";
						std::string library_name = installdir + "buchbergergp.lib";
						args_read  = {base_filename};
						args_in    = {(long) r, (long) final_r, (long) n_syzygies, generator_indices};
						args_inout = {&bigint_test};
						out        = {&output};
						out_many   = {};
						bool delete_files = true;
						bool silent = true;
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute) (library_name, singular_function_name, base_filename+"intermediate_files/", args_read, args_in, args_inout, out, out_many, delete_files, silent);
						//std::cout << "after:  " << bigint_test << std::endl;

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": " << needed_indices.size() << " elements left" << std::endl;
						#endif
						
						double runtime_stop = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						if (measure_timings != 0) {
							runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});
						}

						//std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<connect-read port="singular_options" place="place_singular_options"/>
			<connect-read port="syz_comp" place="place_syz_comp"/>
			<connect-read port="red_syz" place="place_red_syz"/>
			<connect-read port="measure_timings" place="place_measure_timings"/>
			<connect-in port="BB_finished" place="place_BB_finished"/>
			<connect-in port="M" place="place_M"/>
			<connect-in port="r" place="place_r"/>
			<connect-in port="job_queue" place="place_job_queue"/>
			<connect-in port="syzygy_indices" place="place_syzygy_indices"/>
			<connect-inout port="n_syzygies" place="place_n_syzygies"/>
			<connect-out port="generator_indices" place="place_generator_indices"/>
			<connect-out port="output" place="place_output"/>
			<connect-out-many port="needed_indices" place="place_needed_indices"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>



		<transition name="reduce_GB">
			<defun>
				<properties name="gspc">
					<properties name="monitor">
						<properties name="color">
							<property key="started">
								"0x800080 * ${needed_indices.is_syzygy} + 0xff00ff * (1-${needed_indices.is_syzygy})"
							</property>
							<property key="finished">
								"0x800080 * ${needed_indices.is_syzygy} + 0xff00ff * (1-${needed_indices.is_syzygy})"
							</property>
							<property key="failed">
								"0xff0000"
							</property>
						</properties>
						<property key="tooltip">
						   "${needed_indices};"
						</property>
					</properties>
				</properties>
				<require key="compute" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="singular_options" type="bitset"/>
				<in name="syz_comp" type="long"/>
				<in name="red_syz" type="long"/>
				<in name="measure_timings" type="long"/>
				<in name="generator_indices" type="list"/>
				<in name="needed_indices" type="needed_index"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="function_reduce_GB(runtime, base_filename, singular_options, syz_comp, red_syz, generator_indices, needed_indices, measure_timings)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="gspc/util/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="boost/thread/thread.hpp"/>
					<code><![CDATA[
					//std::cout << "ENTERING reduce_GB" << std::endl;
						double runtime_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						int ngens = generator_indices.size();
						std::vector<int> generator_indices_vec = list2vec_long(generator_indices);

						static std::list<poly> generators;
						if (singular_options.is_element(REDSB)) // if no reduced GB os required, we don't need the generators
						{
							double read_poly_start = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

							// add generators to a static variable, so each element will be read in only once per worker
							for (int k=generators.size()+1; k<=ngens; k++)
							{
								generators.emplace_back(RESOLVE_INTERFACE_FUNCTION(read_generator) (base_filename, generator_indices_vec[k-1]));
							}

							double read_poly_stop = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
							if (measure_timings != 0) {
								runtime[(std::string) "reading generators in reduce_GB (static)"] = GpiList({-1.0, read_poly_stop, read_poly_stop-read_poly_start, 1L});
							}
						}

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": reduce_GB: processing " << current_index+1 << "-th element of the Gröbner basis" << std::endl;
						#endif
						std::string singular_function_name = "reduce_GB";
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_reduce_GB) (base_filename, generators, needed_indices.generator, needed_indices.generator_index, needed_indices.save_index, needed_indices.is_syzygy, ngens, syz_comp, red_syz, singular_options, measure_timings, &runtime);

						if (singular_options.is_element(PROT) && singular_options.is_element(REDSB)) {
							std::ofstream prot_file(base_filename + "prot.txt", std::ios::app | std::ios::binary);
							prot_file << "-";
							prot_file.close();
						}

						double runtime_stop = std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						if (measure_timings != 0) {
							runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});
						}

						//std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="singular_options" place="place_singular_options"/>
			<connect-read port="syz_comp" place="place_syz_comp"/>
			<connect-read port="red_syz" place="place_red_syz"/>
			<connect-read port="measure_timings" place="place_measure_timings"/>
			<connect-read port="generator_indices" place="place_generator_indices"/>
			<connect-in port="needed_indices" place="place_needed_indices"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>



	</net>
</defun>
