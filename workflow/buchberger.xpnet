<defun name="buchberger">
	<include-structs href="structures.xpnet"/>

	<in name="input" type="string" place="place_input"/>
	<in name="base_filename" type="string" place="place_base_filename"/>
	<in name="installdir" type="string" place="place_installdir"/>
	<!--in name="redSB" type="long" place="place_redSB"/>
	<in name="degBound" type="long" place="place_degBound"/>
	<in name="nworkers" type="long" place="place_nworkers"/-->
	<out name="output" type="string" place="place_output"/>
	<out name="runtime" type="map" place="place_runtime"/>
	<net>
		<place name="place_base_filename" type="string"/>
		<place name="place_installdir" type="string"/>
		<place name="place_redSB" type="long"/>
		<place name="place_input" type="string"/>
		<place name="place_output" type="string"/>
		<place name="place_BB_finished" type="control"/>
		<place name="place_r" type="int"/>
		<place name="place_update_Qback_r" type="tuple__index_pair__int__set"/>
		<place name="place_M" type="list"/>
		<place name="place_balNF" type="control"/>
		<place name="place_Q" type="list"/>
		<place name="place_Qback" type="index_pair"/>
		<place name="place_started_indices" type="running_reduction"/>
		<place name="place_finished_indices" type="index_pair"/>
		<place name="place_NF" type="list"/>
		<place name="place_needed_indices" type="long"/>
		<place name="place_needed_indices_list" type="list"/>
		<place name="place_blacklist" type="set"/>
		<!--place name="place_degBound" type="long"/-->
		<place name="place_degBounds" type="list"/>
		<place name="place_runtime" type="map"/>


		<transition name="init" priority="3">
			<defun>
				<require key="worker" mandatory="true"/>
       	<in name="base_filename" type="string"/>
				<in name="input" type="string"/>
				<in name="installdir" type="string"/>
				<!--in name="degBound" type="long"/-->
				<out name="degBounds" type="list"/>
				<out name="started_indices" type="list"/>
				<!--out name="Q_out" type="list"/-->
				<out name="Qback" type="index_pair"/>
				<out name="blacklist" type="set"/>
				<out name="r" type="int"/>
				<out name="M" type="list"/>
				<out name="redSB" type="long"/>
				<out name="runtime" type="map"/>
				<out name="balNF" type="list"/>
				<out name="BB_finished" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_init(started_indices, installdir, degBounds, runtime, base_filename, input, Qback, r, M, redSB, balNF, blacklist, BB_finished)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="fstream"/>
					<cinclude href="chrono"/>
					<cinclude href="boost/thread/thread.hpp"/>
					<cinclude href="sys/stat.h"/>
					<cinclude href="sys/types.h"/>

					<code><![CDATA[
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						std::cout << runtime_start << ": ENTERING INIT " << std::endl;

						//GpiList Q; //!!
						sPairQueue Q;
						sPairQueue_by_indices Qind;
						int nvars;

						std::string singular_function_name = "init";
						std::cout << "ENTERING " << singular_function_name << std::endl;

						#ifdef DEBUG_BBA
						std::cout << "start time (time since epoch in ms): " << runtime_start << std::endl;
						std::cout << runtime_start << ": entering " << singular_function_name << std::endl;
						#endif

						// make subdirectories:
						mkdir((base_filename + "intermediate_files"     ).c_str(), 0777);
						mkdir((base_filename + "temporary_files"        ).c_str(), 0777);
						mkdir((base_filename + "result"                 ).c_str(), 0777);
						mkdir((base_filename + "memory"                 ).c_str(), 0777);
						mkdir((base_filename + "queue"                  ).c_str(), 0777);
						mkdir((base_filename + "queue/started"          ).c_str(), 0777);
						mkdir((base_filename + "queue/zero_reduction"   ).c_str(), 0777);
						mkdir((base_filename + "queue/new_element"      ).c_str(), 0777);
						mkdir((base_filename + "queue/chain_criterion"  ).c_str(), 0777);
						mkdir((base_filename + "queue/product_criterion").c_str(), 0777);
						mkdir((base_filename + "queue/cancelled_s_pair" ).c_str(), 0777);
						mkdir((base_filename + "queue/cancelled_element").c_str(), 0777);
						mkdir((base_filename + "queue/degree_bound"     ).c_str(), 0777);
						std::ifstream queueFileIn(base_filename+"queue/NOT_STARTED");
						bool prev_queue_had_started = !queueFileIn.good();
						queueFileIn.close();
						std::ofstream queueFile(base_filename+"queue/NOT_STARTED");
						queueFile.close();


						long nworkers=0; // max number of workers given to NF_of_spoly transition
						int prev_r=0; // value of r from a previous computation that is being continued
						std::vector<std::vector<std::vector<int> > > Mvec; // lead monomials as a vector of exponent vectors (last entry = component)
						RESOLVE_INTERFACE_FUNCTION(singular_init) (base_filename, input, prev_queue_had_started, &Mvec, &degBounds, &redSB, &nworkers, &prev_r, &runtime);

						r = Mvec.size();
						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": r=" << r << ", prev_r=" << prev_r << ", prev_queue_had_started=" << prev_queue_had_started << ", degBounds="<< std::endl;
						print_variant(degBounds);
						#endif


						long prodcrit_counter  = 0L;
						long chaincrit_counter = 0L;
						long degbound_counter = 0L;

						if (prev_r>0 && prev_queue_had_started) // use previous state to initialize Q(ueue)
						{
							r=prev_r;
							if(TRACE>0)
							{
								prev_r=TRACE;
							}
							int j=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mj=Mvec.begin(); j<=r; ++Mj, j++)
							{
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<j; ++Mi, i++)
								{
									std::ifstream ijFileIn(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j));
									std::ifstream ijDegBoundFileIn(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j));
									std::vector<int> lcm_i_j = lcm((*Mi)[0], (*Mj)[0]);

									if ((ijFileIn.good() || ijDegBoundFileIn.good()))
									{
										ijFileIn.close();
										ijDegBoundFileIn.close();
										if (over_deg_bound(lcm_i_j, degBounds))
										{
											// move from started to degree_bound
											ijFileIn.close();
											std::ofstream ijFileOut(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)); ijFileOut.close();
											std::remove((base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j)).c_str());
										}
										else
										{
											std::ifstream ijResFileIn(base_filename+"temporary_files/intermediate_result_"+std::to_string(i)+"_"+std::to_string(j));
											GpiStruct si;
											si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
											si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , j}));
											si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) ijResFileIn.good()}));
											ijResFileIn.close();

											// move from degree_bound to started
											std::ofstream ijFileOut(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j)); ijFileOut.close();
											std::remove((base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)).c_str());

											#ifdef DEBUG_BBA
											std::cout << runtime_start << ": init: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
											#endif

											// add (i,j) to started indices:
											started_indices.push_back(si);

											// add (i,j) and information about lcm(fi,fj) to the queue:
											queue_insert(Q, Qind, i, j, *Mi, *Mj, lcm_i_j, base_filename);
											nvars = lcm_i_j.size();
										}
									}
								}
							}
						}
						else
						{
							int j=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mj=Mvec.begin(); j<=r; ++Mj, j++)
							{
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<j; ++Mi, i++)
								{
									bool add_to_Q = true;
									std::vector<int> lcm_i_j = lcm((*Mi)[0], (*Mj)[0]);
									//if (degBound>0 && degBound < deg(lcm_i_j))
									if (over_deg_bound(lcm_i_j, degBounds))
									{
										add_to_Q=false;
										degbound_counter++;
										std::ofstream ijFile(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
									}
									if (test_PC((*Mi)[0],(*Mj)[0])) // apply PC
									{
										add_to_Q = false;
										prodcrit_counter++;
										std::ofstream ijFile(base_filename+"queue/product_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
									}
									else // apply CC
									{
										int k=1;
										for (std::vector<std::vector<std::vector<int> > >::iterator Mk=Mvec.begin(); k<=r; ++Mk, k++)
										{
											if(k!=i && k!=j)
											{
												if (test_CC(lcm_i_j, (*Mi)[0], (*Mj)[0], (*Mk)[0]))
												{
													if(k<i)
													{
														add_to_Q = false;
														chaincrit_counter++;
														std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
														break;
													}
													else { if(k<j)
													{
														std::vector<int> lcm_k_j = lcm((*Mk)[0], (*Mj)[0]);
														if(!equal(lcm_k_j,lcm_i_j))
														{
															add_to_Q = false;
															chaincrit_counter++;
															std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
															break;
														}
													}
													else // (k>j)
													{
														std::vector<int> lcm_i_k = lcm((*Mi)[0], (*Mk)[0]);
														std::vector<int> lcm_j_k = lcm((*Mj)[0], (*Mk)[0]);
														if(!equal(lcm_i_k,lcm_i_j) && !equal(lcm_j_k,lcm_i_j))
														{
															add_to_Q = false;
															chaincrit_counter++;
															std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
															break;
														}
													}}
												}
											}
										}
									}

									if(add_to_Q)
									{
										GpiStruct si;
										si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
										si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , j}));
										si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) 0}));

										#ifdef DEBUG_BBA
										std::cout << runtime_start << ": init: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
										#endif
										// add (i,j) to started indices:
										started_indices.push_back(si);
										// add (i,j) and information about lcm(fi,fj) to the queue:
										queue_insert(Q, Qind, i, j, *Mi, *Mj, lcm_i_j, base_filename);
										nvars = lcm_i_j.size();
									}
								}
							}
						}

						// build M
						//!!!for(std::vector<std::vector<std::vector<int> > >::iterator Mveci=Mvec.begin(); Mveci!=Mvec.end(); ++Mveci)
						//{
						//	M.emplace_back(vec2list(*Mveci));
						//}
						M = vec2list(Mvec);

						if(Q.size()>0)
						{
							Qback.i = boost::get<int>(           get_list(*--Q.end()).front() );
							Qback.j = boost::get<int>(*std::next(get_list(*--Q.end()).begin()));
						}
						else
						{
							BB_finished.emplace_back(CONTROL_TOKEN);
						}
						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": ----------------------------- Q.size() after init: " << Q.size() << std::endl;
						std::cout << runtime_start << ": --------------- started_indices.size() after init: " << started_indices.size() << std::endl;
						#endif

						// init balNF to limit the number of workers dedicated to NF_of_spoly
						for(int ii=0; ii<nworkers; ii++)
						{
							balNF.emplace_back(CONTROL_TOKEN);
						}

						// init the blcklist
						blacklist = GpiSet({});

						// init LOG file
						std::ofstream logFile(base_filename+"LOG.txt");
						logFile << r << '\n';
						logFile << 0;
						logFile.close();

						// mark queue as "started"
						std::remove((base_filename+"queue/NOT_STARTED").c_str());

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": exiting " << singular_function_name << std::endl;
						#endif

/*
											long serialize_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

											GpiList output;

											std::vector<boost::variant<long,std::string,GpiList>>  args_read2, args_in2;  std::vector<boost::variant<long*,std::string*,GpiList*>>  args_inout2, out2;  std::vector<GpiList*>  out_many2;
											std::string singular_function_name2 = "serialize";
											//std::string library_name = base_filename.substr(0, base_filename.find_last_of('/', base_filename.size() - 2) + 1) + "buchbergergp.lib";
											std::string library_name2 = installdir + "buchbergergp.lib";
											args_read2  = {};
											args_in2    = {Q};
											args_inout2 = {};
											out2        = {&Q_out};
											out_many2   = {};
											bool delete_files2 = false;
											bool silent2 = true;
											RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute) (library_name2, singular_function_name2, base_filename+"intermediate_files/", args_read2, args_in2, args_inout2, out2, out_many2, delete_files2, silent2);

											long serialize_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
											runtime[(std::string) "serialize in init"] = GpiList({-1L, serialize_stop, serialize_stop-serialize_start, 1L});
*/
						//Q_out = Q; //!!
						serialize_queue(Q, base_filename+"queue/Q", nvars);

						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "PRODUCT CRITERION"] = GpiList({-1L, -1L, -1L,  prodcrit_counter});
						runtime[(std::string) "CHAIN CRITERION"] = GpiList({-1L, -1L, -1L, chaincrit_counter});
						runtime[(std::string) "DEGREE BOUND"] = GpiList({-1L, -1L, -1L, degbound_counter});
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<!--connect-read port="degBound" place="place_degBound"/-->
			<connect-in port="input" place="place_input"/>
			<connect-out port="degBounds" place="place_degBounds"/>
			<!--connect-out port="Q_out" place="place_Q"/-->
			<connect-out port="Qback" place="place_Qback"/>
			<connect-out port="blacklist" place="place_blacklist"/>
			<connect-out port="r" place="place_r"/>
			<connect-out port="M" place="place_M"/>
			<connect-out port="runtime" place="place_runtime"/>
			<connect-out port="redSB" place="place_redSB"/>
			<connect-out-many port="started_indices" place="place_started_indices"/>
			<connect-out-many port="balNF" place="place_balNF"/>
			<connect-out-many port="BB_finished" place="place_BB_finished"/>
		</transition>



		<transition name="NF_of_spoly" priority="1">
			<defun>
				<require key="worker" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="blacklist" type="set"/>
				<in name="r" type="int"/>
				<in name="Qback" type="index_pair"/>
				<in name="started_indices" type="running_reduction"/>
				<inout name="balNF" type="control"/>
				<out name="started_indices_out" type="list"/>
				<out name="finished_indices" type="list"/>
				<out name="NF" type="list"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_NF_of_spoly(runtime, base_filename, r, Qback, started_indices, started_indices_out, finished_indices, NF, blacklist)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="fstream"/>
					<cinclude href="boost/archive/binary_iarchive.hpp"/>
					<cinclude href="boost/archive/binary_oarchive.hpp"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
					std::cout << "ENTERING NF_of_spoly" << std::endl;
						bool i_in_bl  = (blacklist.find((GpiVariant) started_indices.i)               !=blacklist.end());
						bool j_in_bl  = (blacklist.find((GpiVariant) started_indices.j)               !=blacklist.end());
						bool ij_in_bl = (blacklist.find(GpiSet({started_indices.i,started_indices.j}))!=blacklist.end());
						if ( ((i_in_bl || j_in_bl) && !ij_in_bl) || blacklist.find(GpiList({started_indices.i,started_indices.j}))!=blacklist.end() )
						{
							return;
						}
						if (i_in_bl && j_in_bl && ij_in_bl)
						{
							GpiStruct fi;
							fi.emplace_back(std::pair<std::string,GpiVariant>({"i"    , started_indices.i}));
							fi.emplace_back(std::pair<std::string,GpiVariant>({"j"    , started_indices.j}));

							//finished_indices.push_back(fi);
							GpiList fi_out = {started_indices.i, started_indices.j};
							NF.push_back(fi_out); //!! for combining increment and remove_from_Q

							return;
						}
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						GpiList si_out;
						GpiList fi_out;

						long read_poly_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						// add generators to a static variable, so each element will be read in only once per worker
						static std::list<poly> generators;
						//static_assert(sizeof(poly)==sizeof(void*));
						for (int k=generators.size()+1; k<=r; k++)
						{
							generators.emplace_back(RESOLVE_INTERFACE_FUNCTION(read_generator) (base_filename, k));
						}

						long read_poly_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "reading generators in NF_of_spoly (static)"] = GpiList({-1L, read_poly_stop, read_poly_stop-read_poly_start, 1L});

						std::string singular_function_name = "NF_of_spoly";
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute_NF) (base_filename, generators, r, Qback.i, Qback.j, started_indices.i, started_indices.j, started_indices.old_r, &runtime, &si_out, &fi_out, &NF);

						if(si_out.size()>0)
						{
							GpiStruct si;
							si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , boost::get<int>(si_out.front())}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , boost::get<int>(si_out.back())}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", r}));

							started_indices_out.push_back(si);

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": 1 NF_of_spoly: adding ("<<boost::get<int>(si_out.front())<<","<<boost::get<int>(si_out.back())<<") to started_indices (old_r="<<started_indices.old_r<<", r="<<r<<")" << std::endl;
							#endif
						}
						if(fi_out.size()>0)
						{
							GpiStruct fi;
							fi.emplace_back(std::pair<std::string,GpiVariant>({"i"    , boost::get<int>(fi_out.front())}));
							fi.emplace_back(std::pair<std::string,GpiVariant>({"j"    , boost::get<int>(fi_out.back())}));

							//finished_indices.push_back(fi);
							NF.push_back(fi_out); //!! for combining increment and remove_from_Q

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": 2 NF_of_spoly: adding ("<<boost::get<int>(fi_out.front())<<","<<boost::get<int>(fi_out.back())<<") to finished_indices (old_r="<<started_indices.old_r<<", r="<<r<<")" << std::endl;
							#endif
						}
						if(NF.size()>0)
						{
							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": 3 NF_of_spoly: adding ("<<boost::get<int>(get_list(NF.front()).front())<<","<<boost::get<int>(*std::next(get_list(NF.front()).begin()))<<") to NF (old_r="<<started_indices.old_r<<", r="<<r<<")" << std::endl;
							#endif
						}
						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});
						if(NF.size()>0) {runtime[(std::string) "min serial runtime"] = GpiList({-1L, runtime_stop, runtime_stop-runtime_start, 1L});}

						std::cout << runtime_start << ": EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<condition>
				((${r} :gt: ${started_indices.old_r}) :and: (${r} :ge: ${started_indices.j}))
			</condition>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-read port="r" place="place_r"/>
			<connect-read port="Qback" place="place_Qback"/>
			<connect-in port="started_indices" place="place_started_indices"/>
			<connect-inout port="balNF" place="place_balNF"/>
			<connect-out-many port="started_indices_out" place="place_started_indices"/>
			<connect-out-many port="finished_indices" place="place_finished_indices"/>
			<connect-out-many port="NF" place="place_NF"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>



	  <transition name="NF_of_spoly_Qback" priority="2">
			<defun>
				<require key="worker" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="blacklist" type="set"/>
				<in name="r" type="int"/>
				<in name="Qback" type="index_pair"/>
				<in name="started_indices" type="running_reduction"/>
				<out name="started_indices_out" type="list"/>
				<out name="finished_indices" type="list"/>
				<out name="NF" type="list"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_NF_of_spoly_Qback(runtime, base_filename, r, Qback, started_indices, started_indices_out, finished_indices, NF, blacklist)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="fstream"/>
					<cinclude href="boost/archive/binary_iarchive.hpp"/>
					<cinclude href="boost/archive/binary_oarchive.hpp"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
					std::cout << "ENTERING NF_of_spoly_Qback" << std::endl;
						bool i_in_bl  = (blacklist.find((GpiVariant) started_indices.i)               !=blacklist.end());
						bool j_in_bl  = (blacklist.find((GpiVariant) started_indices.j)               !=blacklist.end());
						bool ij_in_bl = (blacklist.find(GpiSet({started_indices.i,started_indices.j}))!=blacklist.end());
						if ( ((i_in_bl || j_in_bl) && !ij_in_bl) || blacklist.find(GpiList({started_indices.i,started_indices.j}))!=blacklist.end() )
						{
							return;
						}
						if (i_in_bl && j_in_bl && ij_in_bl)
						{
							GpiStruct fi;
							fi.emplace_back(std::pair<std::string,GpiVariant>({"i"    , started_indices.i}));
							fi.emplace_back(std::pair<std::string,GpiVariant>({"j"    , started_indices.j}));

							finished_indices.push_back(fi);
							GpiList fi_out = {started_indices.i, started_indices.j};
							NF.push_back(fi_out); //!! for combining increment and remove_from_Q

							return;
						}
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						std::cout << runtime_start << ": ENTERING NF_of_spoly_Qback" << std::endl;

						GpiList si_out;
						GpiList fi_out;

						long read_poly_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						// add generators to a static variable, so each element will be read in only once per worker
						static std::list<poly> generators;
						for (int k=generators.size()+1; k<=r; k++)
						{
							generators.emplace_back(RESOLVE_INTERFACE_FUNCTION(read_generator) (base_filename, k));
						}

						long read_poly_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "reading generators in NF_of_spoly (static)"] = GpiList({-1L, read_poly_stop, read_poly_stop-read_poly_start, 1L});

						std::string singular_function_name = "NF_of_spoly_Qback";
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute_NF) (base_filename, generators, r, Qback.i, Qback.j, started_indices.i, started_indices.j, started_indices.old_r, &runtime, &si_out, &fi_out, &NF);


						if(si_out.size()>0)
						{
							GpiStruct si;
							si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , boost::get<int>(si_out.front())}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , boost::get<int>(si_out.back())}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", r}));

							started_indices_out.push_back(si);

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": 1 NF_of_spoly_Qback: adding ("<<boost::get<int>(si_out.front())<<","<<boost::get<int>(si_out.back())<<") to started_indices (old_r="<<started_indices.old_r<<", r="<<r<<")" << std::endl;
							#endif
						}
						if(fi_out.size()>0)
						{
							GpiStruct fi;
							fi.emplace_back(std::pair<std::string,GpiVariant>({"i"    , boost::get<int>(fi_out.front())}));
							fi.emplace_back(std::pair<std::string,GpiVariant>({"j"    , boost::get<int>(fi_out.back())}));

							//finished_indices.push_back(fi);
							NF.push_back(fi_out); //!! for combining increment and remove_from_Q

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": 2 NF_of_spoly_Qback: adding ("<<boost::get<int>(fi_out.front())<<","<<boost::get<int>(fi_out.back())<<") to finished_indices (old_r="<<started_indices.old_r<<", r="<<r<<")" << std::endl;
							#endif
						}
						if(NF.size()>0)
						{
							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": 3 NF_of_spoly_Qback: adding ("<<boost::get<int>(get_list(NF.front()).front())<<","<<boost::get<int>(*std::next(get_list(NF.front()).begin()))<<") to NF (old_r="<<started_indices.old_r<<", r="<<r<<")" << std::endl;
							#endif
						}
						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});
						if(NF.size()>0) {runtime[(std::string) "min serial runtime"] = GpiList({-1L, runtime_stop, runtime_stop-runtime_start, 1L});}

						std::cout << runtime_start << ": EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<condition>
				((${started_indices.i} :eq: ${Qback.i}) :and: (${started_indices.j} :eq: ${Qback.j}) :and: (${r} :ge: ${started_indices.j}))
			</condition>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-read port="r" place="place_r"/>
			<connect-read port="Qback" place="place_Qback"/>
			<connect-in port="started_indices" place="place_started_indices"/>
			<connect-out-many port="started_indices_out" place="place_started_indices"/>
			<connect-out-many port="finished_indices" place="place_finished_indices"/>
			<connect-out-many port="NF" place="place_NF"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>

		<transition name="update_Q" priority="4">
			<defun>
				<require key="queue" mandatory="true"/>
				<in name="nT_started_indices" type="unsigned long"/>
				<in name="base_filename" type="string"/>
				<in name="installdir" type="string"/>
				<in name="degBounds" type="list"/>
				<!--in name="Q_in" type="list"/-->
				<in name="NF" type="list"/>
				<in name="r_in" type="int"/>
				<in name="Qback" type="index_pair"/>
				<in name="blacklist" type="set"/>
				<inout name="M" type="list"/>
				<out name="update_Qback_r" type="list"/>
				<out name="started_indices" type="list"/>
				<out name="runtime" type="map"/>
				<out name="BB_finished" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_increment(installdir, degBounds, runtime, base_filename, NF, Qback, r_in, update_Qback_r, M, started_indices, BB_finished, blacklist, nT_started_indices)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="fstream"/>
					<cinclude href="chrono"/>
					<cinclude href="thread"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
					//SLEEP_MS(100);
					long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();


					int r = r_in;
					GpiSet add_to_blacklist = {};

					/*
						long deserialize_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						GpiList output;

						std::vector<boost::variant<long,std::string,GpiList>>  args_read, args_in;  std::vector<boost::variant<long*,std::string*,GpiList*>>  args_inout, out;  std::vector<GpiList*>  out_many;
						std::string singular_function_name = "deserialize";
						//std::string library_name = base_filename.substr(0, base_filename.find_last_of('/', base_filename.size() - 2) + 1) + "buchbergergp.lib";
						std::string library_name = installdir + "buchbergergp.lib";
						args_read  = {Q_in};
						args_in    = {};
						args_inout = {};
						out        = {&output};
						out_many   = {};
						bool delete_files = false;
						bool silent = true;
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute) (library_name, singular_function_name, base_filename+"intermediate_files/", args_read, args_in, args_inout, out, out_many, delete_files, silent);

						long deserialize_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "deserialize in update_Q"] = GpiList({-1L, deserialize_stop, deserialize_stop-deserialize_start, 1L});

						static GpiList Q = output;
					*/

					//static GpiList Q = Q_in; //!!
					static std::pair<sPairQueue,sPairQueue_by_indices> Q_Qind = deserialize_queue(base_filename+"queue/Q");
					static sPairQueue                Q = Q_Qind.first;
					static sPairQueue_by_indices  Qind = Q_Qind.second;
/*
					//print_variant(*Q.begin());
					if (Qind.find(std::make_pair((int) 11, (int) 13))!=Qind.end())
					{
						std::cout << "true " << std::endl;
						std::cout << " TEST: ("<<11<<","<<13<<")" << " == " << "("<< boost::get<int>((*Qind[std::make_pair((int) 11, (int) 13)]).front()) <<","<< boost::get<int>(*std::next((*Qind[std::make_pair((int) 11, (int) 13)]).begin())) <<")" << "\n\n";
						print_variant(*Qind[std::make_pair(11,13)]);
					}
					else
						std::cout << "false" << std::endl;
*/
					fix_Q(Q,Qind);

					std::cout << runtime_start << ": ENTERING UPDATE_Q:  Q.size()="<<Q.size()<<", nT_started_indices="<<nT_started_indices<< std::endl;

					if(NF.size()==3)
					{
						std::cout << "ENTERING increment" << std::endl;
						std::string singular_function_name = "increment";

						GpiList::const_iterator it = NF.begin();
						int index_i = boost::get<int>(*it); ++it;
					  int index_j = boost::get<int>(*it); ++it;
						GpiVariant m = *it;

						long prodcrit_counter  = 0L;
						long chaincrit_counter = 0L;
						long cancelled_element_counter = 0L;
						long cancelled_s_pair_counter  = 0L;
						long degbound_counter = 0L;

						bool i_in_bl  = (blacklist.find((GpiVariant) index_i)     !=blacklist.end());
						bool j_in_bl  = (blacklist.find((GpiVariant) index_j)     !=blacklist.end());
						bool ij_in_bl = (blacklist.find(GpiSet({index_i,index_j}))!=blacklist.end());
						if (!(((i_in_bl || j_in_bl) && !ij_in_bl) || (i_in_bl && j_in_bl)))
						{
							r++;

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": increasing r from " << r-1 << " to " << r << " due to spoly (" << index_i << "," << index_j << ")"<< std::endl;
							#endif

							M.push_back(m);

							std::vector<std::vector<std::vector<int> > > Mvec;
							for(GpiList::iterator Mi=M.begin(); Mi!=M.end(); ++Mi)
							{
								GpiList Mi_list = get_list(*Mi);
								std::vector<std::vector<int>> Mveci;
								for(GpiList::iterator Mii=Mi_list.begin(); Mii!=Mi_list.end(); ++Mii)
								{
									Mveci.emplace_back(list2vec(*Mii));
								}
								Mvec.emplace_back(Mveci);
							}

							//std::cout << "lcm(leads):" << std::endl;
							//print_variant(vec2list(lcm(Mvec[index_i-1][0],Mvec[index_j-1][0])));

							std::vector<std::vector<int>> Mr = Mvec.back();
							int i=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<r; ++Mi, i++)
							{
								bool add_to_Q = true;
								std::vector<int> lcm_i_r;

								if (blacklist.find((GpiVariant) i) != blacklist.end())
								{
									add_to_Q = false;
								}
								else
								{
									lcm_i_r = lcm((*Mi)[0], Mr[0]);
									//if (degBound>0 && degBound < deg(lcm_i_r))
									if (over_deg_bound(lcm_i_r, degBounds))
									{
										add_to_Q=false;
										degbound_counter++;
										std::ofstream ijFile(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
									}
									if (test_PC((*Mi)[0],Mr[0])) // apply PC
									{
										add_to_Q = false;
										prodcrit_counter++;
										std::ofstream ijFile(base_filename+"queue/product_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
									}
									else // apply CC
									{
										int k=1;
										for (std::vector<std::vector<std::vector<int> > >::iterator Mk=Mvec.begin(); k<=r; ++Mk, k++)
										{
											if(k!=i && k!=r)
											{
												if (test_CC(lcm_i_r, (*Mi)[0], Mr[0], (*Mk)[0]))
												{
													if(k<i)
													{
														add_to_Q = false;
														chaincrit_counter++;
														std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
														break;
													}
													else // thus i<k<r  (k>r is not possible)
													{
														std::vector<int> lcm_k_r = lcm((*Mk)[0], Mr[0]);
														if(!equal(lcm_k_r,lcm_i_r))
														{
															add_to_Q = false;
															chaincrit_counter++;
															std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(r)); ijFile.close();
															break;
														}
													}
												}
											}
										}
									}
								}

								if (divides_monom(Mr[0],(*Mi)[0]) &&  (blacklist.find((GpiVariant) i)==blacklist.end()))
								{
									// new found lead monomial divides i-th lead monomial ==> put i in blacklist
									// (and Set(i,r) as the (i,r)-th spoly has to be reduced, it is not eliminated through CC!)
									add_to_blacklist.emplace(i);
									add_to_blacklist.emplace(GpiSet({i,r}));
									// remove (i,j) for all j from Q:
									queue_delete_i(Q, Qind, i, r, base_filename, "cancelled_element");
									cancelled_element_counter++;
								}

								if(add_to_Q)
								{
									GpiStruct si;
									si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
									si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , r}));
									si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) 0}));
									if(TRACE>0)
									{
										std::ifstream irFile(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(r));
										if(irFile.good())
										{
											started_indices.push_back(si);
											queue_insert(Q, Qind, i, r, *Mi, Mr, lcm_i_r, base_filename);
										}
									}
									else
									{
										#ifdef DEBUG_BBA
										std::cout << runtime_start << ": increment: adding ("<<i<<","<<r<<") to started_indices" << std::endl;
										#endif
										// add (i,r) to started indices:
										started_indices.push_back(si);
										// add (i,r) and information about lcm(fi,fr) to the queue:
										//int Qs = Q.size();
										//int Qis = Qind.size();
										queue_insert(Q, Qind, i, r, *Mi, Mr, lcm_i_r, base_filename);
/*
										if(Q.size()!=Qs+1 || Qind.size()!=Qis+1 || Qs!=Qis)
										{
											std::cout << '\n' << runtime_start << ": increment: FAILED TO ADD ("<<i<<","<<r<<") !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" << std::endl;
											std::cout << runtime_start << ": increment: Q.size() before: "<<Qs<<","<<Qis<<", after:"<<Q.size()<<","<<Qind.size()<<", ENTRY:" << std::endl;
											print_variant(*Qind[std::make_pair(i,r)]);
											std::cout << runtime_start << " " << std::endl;
										}
*/
									}
								}
							}

							for (sPairQueue::iterator Qk=Q.begin(); Qk!=Q.end(); )
							{
								int ii = boost::get<int>(get_list(*Qk).front());
								int jj = boost::get<int>(*std::next(get_list(*Qk).begin()));

								std::vector<int> lcm_i_j = lcm(Mvec[ii-1][0],Mvec[jj-1][0]);

								if(test_CC(lcm_i_j, Mvec[ii-1][0], Mvec[jj-1][0], Mvec[r-1][0]))
								{
									std::vector<int> lcm_i_r = lcm(Mvec[ii-1][0], Mvec[r-1][0]);
									std::vector<int> lcm_j_r = lcm(Mvec[jj-1][0], Mvec[r-1][0]);
									if(!equal(lcm_i_r,lcm_i_j) && !equal(lcm_j_r,lcm_i_j))
									{
										add_to_blacklist.emplace(GpiList({ii,jj}));
										Qk = Q.erase(Qk);
										Qind.erase(std::make_pair(ii,jj));
										chaincrit_counter++;
										cancelled_s_pair_counter++;
										std::remove((base_filename+"queue/started/"+std::to_string(std::min(ii,jj))+"_"+std::to_string(std::max(ii,jj))).c_str());
										std::ofstream ijFile(base_filename+"queue/cancelled_s_pair/"+std::to_string(std::min(ii,jj))+"_"+std::to_string(std::max(ii,jj))); ijFile.close();
									}
									else {++Qk;}
								}
								else {++Qk;}
							}
						}

						queue_delete_i_j(Q, Qind, index_i, index_j, base_filename, "new_element");


						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": increment: set size of Q(ueue) to " << Q.size() <<std::endl;
						#endif

						std::cout << "s(" << Q.size() << ")" << std::endl;

						std::ofstream logFile(base_filename+"LOG.txt");
						logFile << r << '\n';
						logFile << (Q.size());
						logFile.close();


						if(Q.size()>0)
						{
							//Qback.i = boost::get<int>(           get_list(Q.back()).front() );
							//Qback.j = boost::get<int>(*std::next(get_list(Q.back()).begin()));
							int new_Qback_i = boost::get<int>(           get_list(*--Q.end()).front() );
							int new_Qback_j = boost::get<int>(*std::next(get_list(*--Q.end()).begin()));

							if (new_Qback_i!=Qback.i || new_Qback_j!=Qback.j || r!=r_in || add_to_blacklist.size()>0)
							{
								GpiStruct new_Qback;
								new_Qback.emplace_back(std::pair<std::string,GpiVariant>({"i"    , new_Qback_i}));
								new_Qback.emplace_back(std::pair<std::string,GpiVariant>({"j"    , new_Qback_j}));
								GpiStruct new_values;
								new_values.emplace_back(std::pair<std::string,GpiVariant>({"first" , new_Qback}));
								new_values.emplace_back(std::pair<std::string,GpiVariant>({"second", r}));
								new_values.emplace_back(std::pair<std::string,GpiVariant>({"third" , add_to_blacklist}));
								update_Qback_r.emplace_back(new_values);
							}

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": current Qback:  " << new_Qback_i << "," << new_Qback_j << std::endl;
							#endif
						}
						else // queue empty
						{
							std::cout << runtime_start << ": ########################################## Buchberger Algorithm finished (in 'increment'!) ##########################################" << std::endl;
							BB_finished.emplace_back(CONTROL_TOKEN);
						}


						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "PRODUCT CRITERION"] = GpiList({-1L, -1L, -1L,  prodcrit_counter});
						runtime[(std::string) "CHAIN CRITERION"] = GpiList({-1L, -1L, -1L, chaincrit_counter});
						runtime[(std::string) "DEGREE BOUND"] = GpiList({-1L, -1L, -1L, degbound_counter});
						runtime[(std::string) "CANCELLED ELEMENTS"] = GpiList({-1L, -1L, -1L,  cancelled_element_counter});
						runtime[(std::string) "CANCELLED S-PAIRS"] = GpiList({-1L, -1L, -1L,  cancelled_s_pair_counter});
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						std::cout << "EXITING " << singular_function_name << std::endl;
					}
					else
					{
						std::cout << "ENTERING remove_from_Q" << std::endl;
						std::string singular_function_name = "remove_from_Q";

						int index_i = boost::get<int>(NF.front());
						int index_j = boost::get<int>(NF.back());
						queue_delete_i_j(Q, Qind, index_i, index_j, base_filename, "zero_reduction");

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": remove_from_Q: removed element (" << index_i << "," << index_j << ") from Q(ueue) as it reduced to 0, size of Q: " << Q.size() <<std::endl;
						#endif
						int Q_size = Q.size();
						if (Q_size%100==0 || (Q_size<100 && Q_size%10==0))
						{
							std::cout << "(" << Q_size << ")" << std::endl;
						}

						std::ifstream logFileIn(base_filename+"LOG.txt");
						std::string oldLine1, oldLine2;
						std::getline(logFileIn, oldLine1);
						std::getline(logFileIn, oldLine2);
						logFileIn.close();

						std::ofstream logFile(base_filename+"LOG.txt",std::ios::trunc);
						logFile << oldLine1 << '\n';
						logFile << (Q.size());
						logFile.close();

						if(Q.size()>0)
						{
							//Qback.i = boost::get<int>(           get_list(Q.back()).front() );
							//Qback.j = boost::get<int>(*std::next(get_list(Q.back()).begin()));
							int new_Qback_i = boost::get<int>(           get_list(*--Q.end()).front() );
							int new_Qback_j = boost::get<int>(*std::next(get_list(*--Q.end()).begin()));

							if (new_Qback_i!=Qback.i || new_Qback_j!=Qback.j || r!=r_in || add_to_blacklist.size()>0)
							{
								GpiStruct new_Qback;
								new_Qback.emplace_back(std::pair<std::string,GpiVariant>({"i"    , new_Qback_i}));
								new_Qback.emplace_back(std::pair<std::string,GpiVariant>({"j"    , new_Qback_j}));
								GpiStruct new_values;
								new_values.emplace_back(std::pair<std::string,GpiVariant>({"first" , new_Qback}));
								new_values.emplace_back(std::pair<std::string,GpiVariant>({"second", r}));
								new_values.emplace_back(std::pair<std::string,GpiVariant>({"third" , add_to_blacklist}));
								update_Qback_r.emplace_back(new_values);
							}

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": current Qback:  " << new_Qback_i << "," << new_Qback_j << std::endl;
							#endif
						}
						else // queue empty
						{
							std::cout << runtime_start << ": ########################################## Buchberger Algorithm finished ##########################################" << std::endl;
							BB_finished.emplace_back(CONTROL_TOKEN);
						}

						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						std::cout << "EXITING " << singular_function_name << std::endl;
					}
					]]></code>
				</module>
			</defun>
			<connect-number-of-tokens port="nT_started_indices" place="place_started_indices"/>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<connect-read port="degBounds" place="place_degBounds"/>
			<!--connect-read port="Q_in" place="place_Q"/-->
			<connect-read port="r_in" place="place_r"/>
			<connect-read port="Qback" place="place_Qback"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-in port="NF" place="place_NF"/>
			<connect-inout port="M" place="place_M"/>
			<connect-out port="runtime" place="place_runtime"/>
			<connect-out-many port="update_Qback_r" place="place_update_Qback_r"/>
			<connect-out-many port="started_indices" place="place_started_indices"/>
			<connect-out-many port="BB_finished" place="place_BB_finished"/>
		</transition>


		<transition name="update_Qback_and_r" priority="5">
			<defun>
				<require key="queue" mandatory="true"/>
				<in name="update_Qback_r" type="tuple__index_pair__int__set"/>
				<inout name="Qback" type="index_pair"/>
				<inout name="r" type="int"/>
				<inout name="blacklist" type="set"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="update_Qback_and_r(update_Qback_r, Qback, r, blacklist)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="chrono"/>
					<code><![CDATA[

						Qback = update_Qback_r.first;
						r     = update_Qback_r.second;
						blacklist.insert(update_Qback_r.third.begin(), update_Qback_r.third.end());

					]]></code>
				</module>
			</defun>
			<connect-in port="update_Qback_r" place="place_update_Qback_r"/>
			<connect-inout port="Qback" place="place_Qback"/>
			<connect-inout port="r" place="place_r"/>
			<connect-inout port="blacklist" place="place_blacklist"/>
		</transition>


		<transition name="minimize_GB" priority="3">
			<defun>
				<require key="worker" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="installdir" type="string"/>
				<in name="BB_finished" type="control"/>
				<in name="M" type="list"/>
				<out name="needed_indices_list" type="list"/>
				<out name="needed_indices" type="list"/>
				<out name="output" type="string"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_minimize_GB(runtime, base_filename, installdir, M, needed_indices_list, needed_indices, output)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
					std::cout << "ENTERING minimize_GB" << std::endl;
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						int r=M.size();

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": minimizing Gröbner basis with initially " << r << " elements" << std::endl;
						#endif

						std::vector<std::vector<std::vector<int> > > Mvec;
						for(GpiList::const_iterator Mi=M.begin(); Mi!=M.end(); ++Mi)
						{
							GpiList Mi_list = get_list(*Mi);
							std::vector<std::vector<int>> Mveci;
							for(GpiList::iterator Mii=Mi_list.begin(); Mii!=Mi_list.end(); ++Mii)
							{
								Mveci.emplace_back(list2vec((*Mii)));
							}
							Mvec.emplace_back(Mveci);
						}

						bool needed;
						for(int i=0; i<r; i++)
						{
							needed = true;
							for(int j=0; j<r; j++) {
								if(j!=i) {
								if(divides_monom(Mvec[j][0],Mvec[i][0])) {
									if(i<j || !(equal(Mvec[i][0],Mvec[j][0]))) {
										needed = false; break;
								}}}
							}
							if(needed)
							{
								needed_indices_list.emplace_back((long) (i+1));
								needed_indices.emplace_back((long) (i+1));
							}
						}
						int final_r = size(needed_indices);

						std::vector<boost::variant<long,std::string,GpiList>>  args_read, args_in;  std::vector<boost::variant<long*,std::string*,GpiList*>>  args_inout, out;  std::vector<GpiList*>  out_many;
						std::string singular_function_name = "minimize_GB";
						//std::string library_name = base_filename.substr(0, base_filename.find_last_of('/', base_filename.size() - 2) + 1) + "buchbergergp.lib";
						std::string library_name = installdir + "buchbergergp.lib";
						args_read  = {base_filename};
						args_in    = {(long) r,(long) final_r, needed_indices_list};
						args_inout = {};
						out        = {&output};
						out_many   = {};
						bool delete_files = true;
						bool silent = true;
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute) (library_name, singular_function_name, base_filename+"intermediate_files/", args_read, args_in, args_inout, out, out_many, delete_files, silent);

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": " << needed_indices.size() << " elements left" << std::endl;
						#endif

						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<connect-in port="BB_finished" place="place_BB_finished"/>
			<connect-in port="M" place="place_M"/>
			<connect-out port="needed_indices_list" place="place_needed_indices_list"/>
			<connect-out port="output" place="place_output"/>
			<connect-out-many port="needed_indices" place="place_needed_indices"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>



		<transition name="reduce_GB" priority="3">
			<defun>
				<require key="worker" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="redSB" type="long"/>
				<in name="needed_indices_list" type="list"/>
				<in name="needed_indices" type="long"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="function_reduce_GB(runtime, base_filename, redSB, needed_indices_list, needed_indices)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="boost/thread/thread.hpp"/>
					<code><![CDATA[
					std::cout << "ENTERING reduce_GB" << std::endl;
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						int final_r = needed_indices_list.size();
						std::vector<int> needed_indices_vec = list2vec_long(needed_indices_list);

						static std::list<poly> generators;
						if (redSB) // if no reduced GB os required, we don't need the generators
						{
							long read_poly_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

							// add generators to a static variable, so each element will be read in only once per worker
							for (int k=generators.size()+1; k<=final_r; k++)
							{
								generators.emplace_back(RESOLVE_INTERFACE_FUNCTION(read_generator) (base_filename, needed_indices_vec[k-1]));
							}

							long read_poly_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
							runtime[(std::string) "reading generators in reduce_GB (static)"] = GpiList({-1L, read_poly_stop, read_poly_stop-read_poly_start, 1L});
						}
						int current_index = (int) std::distance( needed_indices_vec.begin(), std::find(needed_indices_vec.begin(), needed_indices_vec.end(), needed_indices) ); // GET_INDEX(needed_indices_vec, needed_indices); // index in generators that has to be reduced w.r.t. the other generators

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": reduce_GB: processing " << current_index+1 << "-th element of the Gröbner basis" << std::endl;
						#endif
						std::string singular_function_name = "reduce_GB";
						RESOLVE_INTERFACE_FUNCTION(singular_buchberger_reduce_GB) (base_filename, generators, needed_indices, current_index, final_r, redSB, &runtime);

						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="redSB" place="place_redSB"/>
			<connect-read port="needed_indices_list" place="place_needed_indices_list"/>
			<connect-in port="needed_indices" place="place_needed_indices"/>
			<connect-out port="runtime" place="place_runtime"/>
		</transition>
	</net>
</defun>
