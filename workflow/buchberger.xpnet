		<!--transition name="register_finished_NF" priority="50">
			<defun>
				<in  name="NF_in"  type="list"/>
				<out name="NF_out" type="list"/>
				<inout name="job_queue_running"  type="set"/>
				<module name="singular_buchberger"
								require_function_unloads_without_rest="false"
								function="register_finished_NF(NF_in, NF_out, job_queue_running)">
					<cinclude href="interface/buchberger_interface.hpp"/>
