<defun name="buchberger">
	<include-structs href="structures.xpnet"/>

	<in name="input" type="string" place="place_input"/>
	<in name="base_filename" type="string" place="place_base_filename"/>
	<in name="installdir" type="string" place="place_installdir"/>
	<!--in name="redSB" type="long" place="place_redSB"/>
	<in name="degBound" type="long" place="place_degBound"/>
	<in name="nworkers" type="long" place="place_nworkers"/-->
	<out name="output" type="string" place="place_output"/>
	<out name="runtime" type="map" place="place_runtime"/>
	<net>
		<place name="place_base_filename" type="string"/>
		<place name="place_installdir" type="string"/>
		<place name="place_redSB" type="long"/>
		<place name="place_input" type="string"/>
		<place name="place_output" type="string"/>
		<place name="place_BB_finished" type="control"/>
		<place name="place_r" type="int"/>
		<place name="place_update_Qback_r" type="tuple__index_pair__int__set"/>
		<place name="place_M" type="list"/>
		<place name="place_balNF" type="control"/>
		<!--place name="place_Q" type="list"/-->
		<place name="place_Qback" type="index_pair"/>
		<place name="place_job_queue" type="list"/>
		<place name="place_update_job_queue" type="list"/>
		<place name="place_job_queue_running" type="set"/>
		<place name="place_started_indices" type="running_reduction"/>
		<place name="place_paused_indices" type="running_reduction"/>
		<place name="place_finished_indices" type="index_pair"/>
		<place name="place_NF" type="list"/>
		<!--place name="place_NF2" type="list"/-->
		<place name="place_needed_indices" type="long"/>
		<place name="place_needed_indices_list" type="list"/>
		<place name="place_blacklist" type="set"/>
		<!--place name="place_degBound" type="long"/-->
		<place name="place_degBounds" type="list"/>
		<place name="place_nrunning" type="int"/>
		<place name="place_nworkers" type="int"/>
		<place name="place_runtime" type="map"/>
		<place name="place_NF_list" type="map"/>
		<place name="place_NF_list_input" type="map"/>
		<!--place name="place_once" type="control">
			<token>
					<value>[]</value>
			</token>
		</place-->
		<place name="place_enable_get_NF_list" type="control">
			<token>
					<value>[]</value>
			</token>
		</place>
		<place name="place_enable_update_Q" type="control">
			<token>
					<value>[]</value>
			</token>
		</place>

		<transition name="init" priority="3">
			<defun>
				<require key="NF_of_spoly_Qback" mandatory="true"/>
       	<in name="base_filename" type="string"/>
				<in name="input" type="string"/>
				<in name="installdir" type="string"/>
				<!--in name="degBound" type="long"/-->
				<out name="nworkers" type="int"/>
				<out name="nrunning" type="int"/>
				<out name="degBounds" type="list"/>
				<out name="started_indices" type="list"/>
				<out name="job_queue" type="list"/>
				<out name="job_queue_running" type="set"/>
				<!--out name="Q_out" type="list"/-->
				<out name="Qback" type="index_pair"/>
				<out name="blacklist" type="set"/>
				<out name="r" type="int"/>
				<out name="M" type="list"/>
				<out name="redSB" type="long"/>
				<out name="NF_list" type="map"/>
				<out name="runtime" type="map"/>
				<out name="balNF" type="list"/>
				<out name="BB_finished" type="list"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_init(NF_list, started_indices, installdir, degBounds, nworkers, nrunning, runtime, base_filename, input, Qback, r, M, redSB, balNF, blacklist, BB_finished, job_queue, job_queue_running)">
				  <cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="fstream"/>
					<cinclude href="chrono"/>
					<cinclude href="boost/thread/thread.hpp"/>
					<cinclude href="sys/stat.h"/>
					<cinclude href="sys/types.h"/>

					<code><![CDATA[
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						std::cout << runtime_start << ": ENTERING INIT " << std::endl;

						int nvars;

						nrunning=0;
						job_queue_running = GpiSet({});

						NF_list = GpiMap({});
						//NF_list[(int) 0] = GpiSet({});

						std::string singular_function_name = "init";
						std::cout << "ENTERING " << singular_function_name << std::endl;

						#ifdef DEBUG_BBA
						std::cout << "start time (time since epoch in ms): " << runtime_start << std::endl;
						std::cout << runtime_start << ": entering " << singular_function_name << std::endl;
						#endif

						// make subdirectories:
						mkdir((base_filename + "intermediate_files"     ).c_str(), 0777);
						mkdir((base_filename + "temporary_files"        ).c_str(), 0777);
						mkdir((base_filename + "result"                 ).c_str(), 0777);
						mkdir((base_filename + "memory"                 ).c_str(), 0777);
						mkdir((base_filename + "queue"                  ).c_str(), 0777);
						mkdir((base_filename + "queue/started"          ).c_str(), 0777);
						mkdir((base_filename + "queue/zero_reduction"   ).c_str(), 0777);
						mkdir((base_filename + "queue/new_element"      ).c_str(), 0777);
						mkdir((base_filename + "queue/chain_criterion"  ).c_str(), 0777);
						mkdir((base_filename + "queue/product_criterion").c_str(), 0777);
						mkdir((base_filename + "queue/cancelled_s_pair" ).c_str(), 0777);
						mkdir((base_filename + "queue/cancelled_element").c_str(), 0777);
						mkdir((base_filename + "queue/degree_bound"     ).c_str(), 0777);
						std::ifstream queueFileIn(base_filename+"queue/NOT_STARTED");
						bool prev_queue_had_started = !queueFileIn.good();
						queueFileIn.close();
						std::ofstream queueFile(base_filename+"queue/NOT_STARTED");
						queueFile.close();


						long nworkers_long=0; // max number of workers given to NF_of_spoly transition
						int prev_r=0; // value of r from a previous computation that is being continued
						std::vector<std::vector<std::vector<int> > > Mvec; // lead monomials as a vector of exponent vectors (last entry = component)
						RESOLVE_INTERFACE_FUNCTION(singular_init) (base_filename, input, prev_queue_had_started, &Mvec, &degBounds, &redSB, &nworkers_long, &prev_r, &runtime);
						nworkers = (int) nworkers_long;

						//GpiList Q; //!!
						sPairQueue Q(nworkers*HEAD_SIZE_FACTOR);
						//sPairQueue_by_indices Qind;

						r = Mvec.size();
						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": r=" << r << ", prev_r=" << prev_r << ", prev_queue_had_started=" << prev_queue_had_started << ", degBounds="<< std::endl;
						print_variant(degBounds);
						#endif


						long prodcrit_counter  = 0L;
						long chaincrit_counter = 0L;
						long degbound_counter = 0L;

						if (prev_r>0 && prev_queue_had_started) // use previous state to initialize Q(ueue)
						{
							r=prev_r;
							if(TRACE>0)
							{
								prev_r=TRACE;
							}
							int j=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mj=Mvec.begin(); j<=r; ++Mj, j++)
							{
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<j; ++Mi, i++)
								{
									std::ifstream ijFileIn(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j));
									std::ifstream ijDegBoundFileIn(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j));
									std::vector<int> lcm_i_j = lcm((*Mi)[0], (*Mj)[0]);

									if ((ijFileIn.good() || ijDegBoundFileIn.good()))
									{
										ijFileIn.close();
										ijDegBoundFileIn.close();
										if (over_deg_bound(lcm_i_j, degBounds))
										{
											// move from started to degree_bound
											ijFileIn.close();
											std::ofstream ijFileOut(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)); ijFileOut.close();
											std::remove((base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j)).c_str());
										}
										else
										{
											// move from degree_bound to started
											std::ofstream ijFileOut(base_filename+"queue/started/"+std::to_string(i)+"_"+std::to_string(j)); ijFileOut.close();
											std::remove((base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)).c_str());

											int state=0;

											std::ifstream ijResFileIn(base_filename+"temporary_files/intermediate_result_"+std::to_string(i)+"_"+std::to_string(j));
											if(ijResFileIn.good())
											{
												GpiStruct si;
												si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
												si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , j}));
												si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) ijResFileIn.good()}));
												ijResFileIn.close();

												#ifdef DEBUG_BBA
												std::cout << runtime_start << ": init: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
												#endif

												// add (i,j) to started indices:
												started_indices.push_back(si);
												nrunning++;
												state=1;
											}

											// add (i,j) and information about lcm(fi,fj) to the queue:
											queue_insert(Q, i, j, *Mi, *Mj, lcm_i_j, base_filename, state);
											nvars = lcm_i_j.size();
										}
									}
								}
							}
						}
						else
						{
							int j=1;
							for (std::vector<std::vector<std::vector<int> > >::iterator Mj=Mvec.begin(); j<=r; ++Mj, j++)
							{
								int i=1;
								for (std::vector<std::vector<std::vector<int> > >::iterator Mi=Mvec.begin(); i<j; ++Mi, i++)
								{
									bool add_to_Q = true;
									std::vector<int> lcm_i_j = lcm((*Mi)[0], (*Mj)[0]);
									//if (degBound>0 && degBound < deg(lcm_i_j))
									if (over_deg_bound(lcm_i_j, degBounds))
									{
										add_to_Q=false;
										degbound_counter++;
										std::ofstream ijFile(base_filename+"queue/degree_bound/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
									}
									if (test_PC((*Mi)[0],(*Mj)[0])) // apply PC
									{
										add_to_Q = false;
										prodcrit_counter++;
										std::ofstream ijFile(base_filename+"queue/product_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
									}
									else // apply CC
									{
										int k=1;
										for (std::vector<std::vector<std::vector<int> > >::iterator Mk=Mvec.begin(); k<=r; ++Mk, k++)
										{
											if(k!=i && k!=j)
											{
												if (test_CC(lcm_i_j, (*Mi)[0], (*Mj)[0], (*Mk)[0]))
												{
													if(k<i)
													{
														add_to_Q = false;
														chaincrit_counter++;
														std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
														break;
													}
													else { if(k<j)
													{
														std::vector<int> lcm_k_j = lcm((*Mk)[0], (*Mj)[0]);
														if(!equal(lcm_k_j,lcm_i_j))
														{
															add_to_Q = false;
															chaincrit_counter++;
															std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
															break;
														}
													}
													else // (k>j)
													{
														std::vector<int> lcm_i_k = lcm((*Mi)[0], (*Mk)[0]);
														std::vector<int> lcm_j_k = lcm((*Mj)[0], (*Mk)[0]);
														if(!equal(lcm_i_k,lcm_i_j) && !equal(lcm_j_k,lcm_i_j))
														{
															add_to_Q = false;
															chaincrit_counter++;
															std::ofstream ijFile(base_filename+"queue/chain_criterion/"+std::to_string(i)+"_"+std::to_string(j)); ijFile.close();
															break;
														}
													}}
												}
											}
										}
									}

									if(add_to_Q)
									{
										/*  //!!!
										GpiStruct si;
										si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
										si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , j}));
										si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) 0}));

										#ifdef DEBUG_BBA
										std::cout << runtime_start << ": init: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
										#endif
										// add (i,j) to started indices:
										started_indices.push_back(si);
										*/

										// add (i,j) and information about lcm(fi,fj) to the queue:
										queue_insert(Q, i, j, *Mi, *Mj, lcm_i_j, base_filename, 0);
										nvars = lcm_i_j.size();
									}
								}
							}
						}

						// build M
						//!!for(std::vector<std::vector<std::vector<int> > >::iterator Mveci=Mvec.begin(); Mveci!=Mvec.end(); ++Mveci)
						//{
						//	M.emplace_back(vec2list(*Mveci));
						//}
						M = vec2list(Mvec);

						// start jobs:
						job_queue = GpiList({});
						for(sPairQueue::iterator entry=Q.begin(); entry!=Q.hend(); ++entry)
						{
							std::pair<int,int> indices = (*entry).first;
							job_queue.emplace_back(GpiList({indices.first,indices.second}));


							/* //STARTED_INDICES
							GpiList data = (*entry).second;
							GpiList::const_iterator it = data.begin();
							int i=boost::get<int>(*it); ++it;
							int j=boost::get<int>(*it); ++it;

							GpiStruct si;
							si.emplace_back(std::pair<std::string,GpiVariant>({"i"    , i}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"j"    , j}));
							si.emplace_back(std::pair<std::string,GpiVariant>({"old_r", (int) 0}));

							#ifdef DEBUG_BBA
							std::cout << runtime_start << ": init: adding ("<<i<<","<<j<<") to started_indices" << std::endl;
							#endif
							// add (i,j) to started indices:
							started_indices.push_back(si);
							nrunning++;
							*/
						}

						//fix_Q(Q,,&nrunning);

						//!!!

						if(Q.size()>0)
						{
							//std::cout << runtime_start << ": ----------------------------- (           get_list((*--Q.end()).second).front() ).which(): " << (           get_list((*--Q.end()).second).front() ).which() << std::endl;
							Qback.i = Q.front_key().first;
							//std::cout << runtime_start << ": ----------------------------- (*std::next(get_list((*--Q.end()).second).begin())).which(): " << (*std::next(get_list((*--Q.end()).second).begin())).which() << std::endl;
							Qback.j = Q.front_key().second;
						}
						else
						{
							BB_finished.emplace_back(CONTROL_TOKEN);
						}
						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": ----------------------------- Q.size() after init: " << Q.size() << std::endl;
						std::cout << runtime_start << ": --------------- started_indices.size() after init: " << started_indices.size() << std::endl;
						#endif

						// init balNF to limit the number of workers dedicated to NF_of_spoly
						for(int ii=0; ii<nworkers; ii++)
						{
							balNF.emplace_back(CONTROL_TOKEN);
						}

						// init the blcklist
						blacklist = GpiSet({});

						// init LOG file
						std::ofstream logFile(base_filename+"LOG.txt");
						logFile << r << '\n';
						logFile << 0;
						logFile.close();

						std::ofstream debugfile(base_filename+"debug.txt");
						debugfile << "initial lead monomials:\n";
						for(std::vector<std::vector<int>> leadmon : Mvec)
						{
							debugfile << "[ ";
							for(std::vector<int> entry : leadmon)
							{
								debugfile << "( ";
								for (int x : entry) {
									debugfile << x << " ";
								}
								debugfile << ") ";

							}
							debugfile << "]\n";
						}
						debugfile << "\n";

						// mark queue as "started"
						std::remove((base_filename+"queue/NOT_STARTED").c_str());

						std::cout << "\nQUEUE AFTER INIT:"<< std::endl;
						for (sPairQueue::const_iterator itQ = Q.begin(); itQ!=Q.end(); ++itQ)
						{
							int index_i = (itQ->first).first;
							int index_j = (itQ->first).second;
							std::cout << "    ("<< index_i<<","<<index_j<<")" << std::endl;
							debugfile << "("<< index_i<<","<<index_j<<") ";
						}
						debugfile << "\n\n";
						debugfile.close();

						std::cout << "\nLEADS AFTER INIT:"<< std::endl;
						print_variant(M);

						#ifdef DEBUG_BBA
						std::cout << runtime_start << ": exiting " << singular_function_name << std::endl;
						#endif

/*
											long serialize_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

											GpiList output;

											std::vector<boost::variant<long,std::string,GpiList>>  args_read2, args_in2;  std::vector<boost::variant<long*,std::string*,GpiList*>>  args_inout2, out2;  std::vector<GpiList*>  out_many2;
											std::string singular_function_name2 = "serialize";
											//std::string library_name = base_filename.substr(0, base_filename.find_last_of('/', base_filename.size() - 2) + 1) + "buchbergergp.lib";
											std::string library_name2 = installdir + "buchbergergp.lib";
											args_read2  = {};
											args_in2    = {Q};
											args_inout2 = {};
											out2        = {&Q_out};
											out_many2   = {};
											bool delete_files2 = false;
											bool silent2 = true;
											RESOLVE_INTERFACE_FUNCTION(singular_buchberger_compute) (library_name2, singular_function_name2, base_filename+"intermediate_files/", args_read2, args_in2, args_inout2, out2, out_many2, delete_files2, silent2);

											long serialize_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
											runtime[(std::string) "serialize in init"] = GpiList({-1L, serialize_stop, serialize_stop-serialize_start, 1L});
*/
						//Q_out = Q; //!!
						serialize_queue(Q, base_filename+"queue/Q", nvars);

						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime[(std::string) "PRODUCT CRITERION"] = GpiList({-1L, -1L, -1L,  prodcrit_counter});
						runtime[(std::string) "CHAIN CRITERION"] = GpiList({-1L, -1L, -1L, chaincrit_counter});
						runtime[(std::string) "DEGREE BOUND"] = GpiList({-1L, -1L, -1L, degbound_counter});
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						std::cout << "EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="installdir" place="place_installdir"/>
			<!--connect-read port="degBound" place="place_degBound"/-->
			<connect-in port="input" place="place_input"/>
			<connect-out port="nworkers" place="place_nworkers"/>
			<connect-out port="nrunning" place="place_nrunning"/>
			<connect-out port="degBounds" place="place_degBounds"/>
			<!--connect-out port="Q_out" place="place_Q"/-->
			<connect-out port="Qback" place="place_Qback"/>
			<connect-out port="blacklist" place="place_blacklist"/>
			<connect-out port="r" place="place_r"/>
			<connect-out port="M" place="place_M"/>
			<connect-out port="NF_list" place="place_NF_list"/>
			<connect-out port="runtime" place="place_runtime"/>
			<connect-out port="redSB" place="place_redSB"/>
			<connect-out port="job_queue" place="place_job_queue"/>
			<connect-out port="job_queue_running" place="place_job_queue_running"/>
			<connect-out-many port="started_indices" place="place_started_indices"/>
			<connect-out-many port="balNF" place="place_balNF"/>
			<connect-out-many port="BB_finished" place="place_BB_finished"/>
		</transition>



		<!--transition name="NF_of_spoly_debug" priority="1">
			<defun>
				<require key="start_jobs" mandatory="true"/>
				<in name="base_filename" type="string"/>
				<in name="blacklist" type="set"/>
				<in name="r" type="int"/>
				<in name="Qback" type="index_pair"/>
				<in name="started_indices" type="running_reduction"/>
				<inout name="balNF" type="control"/>
				<out name="started_indices_out" type="running_reduction"/>
				<out name="runtime" type="map"/>
				<module name="singular_buchberger"
							  require_function_unloads_without_rest="false"
							  function="function_NF_of_spoly_debug(runtime, base_filename, r, Qback, started_indices, blacklist, started_indices_out)">
					<cinclude href="interface/buchberger_interface.hpp"/>
					<cinclude href="util-generic/dynamic_linking.hpp"/>
					<cinclude href="boost/variant.hpp"/>
					<cinclude href="iostream"/>
					<cinclude href="chrono"/>
					<cinclude href="fstream"/>
					<cinclude href="boost/archive/binary_iarchive.hpp"/>
					<cinclude href="boost/archive/binary_oarchive.hpp"/>
					<cinclude href="boost/thread/thread.hpp"/>

					<code><![CDATA[
						std::string singular_function_name = "NF_of_spoly_debug";
						//std::cout << "ENTERING " << singular_function_name << std::endl;
						long runtime_start = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();

						//std::cout << "("<<started_indices.i<<","<<started_indices.j<<"): r="<<r<<", s_i.old_r="<<started_indices.old_r<<",  condition: "<<(r > started_indices.old_r)<<" AND "<<(r >= started_indices.j)<<" = "<<((r > started_indices.old_r) && (r >= started_indices.j)) << std::endl;
						if (r > started_indices.old_r) {std::cout << "Qback=("<<Qback.i<<","<<Qback.j<<")  CONDITION TRUE:   (i,j)=("<<started_indices.i<<","<<started_indices.j<<"), r="<<r<<", old_r="<<started_indices.old_r << "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" << std::endl;}
						else {std::cout << "Qback=("<<Qback.i<<","<<Qback.j<<")  CONDITION FALSE:  (i,j)=("<<started_indices.i<<","<<started_indices.j<<"), r="<<r<<", old_r="<<started_indices.old_r << std::endl;}
						started_indices_out = started_indices;

						long runtime_stop = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::high_resolution_clock::now().time_since_epoch()).count();
						runtime["TRANSITION "+singular_function_name+" TOTAL"] = GpiList({runtime_start, runtime_stop, runtime_stop-runtime_start, 1L});

						//std::cout << runtime_start << ": EXITING " << singular_function_name << std::endl;
					]]></code>
				</module>
			</defun>
			<connect-read port="base_filename" place="place_base_filename"/>
			<connect-read port="blacklist" place="place_blacklist"/>
			<connect-read port="r" place="place_r"/>
			<connect-read port="Qback" place="place_Qback"/>
			<connect-in port="started_indices" place="place_started_indices"/>
