<structs>

  <struct name="running_reduction">
    <field name="i"      type="int"/>
    <field name="j"      type="int"/>
    <field name="old_r"  type="int"/>
    <field name="syzygy" type="int"/>
	</struct>

  <struct name="needed_index">
    <field name="generator" type="int"/>
    <field name="generator_index" type="int"/>
    <field name="save_index" type="int"/>
    <field name="is_syzygy" type="int"/>
  </struct>

  <struct name="index_pair">
    <field name="i" type="int"/>
    <field name="j" type="int"/>
  </struct>

  <struct name="reduction_result">
    <field name="i" type="int"/>
    <field name="j" type="int"/>
    <field name="old_r" type="int"/>
    <field name="lead_data" type="list"/>
  </struct>

  <struct name="timing">
    <field name="start" type="double"/>
    <field name="stop"  type="double"/>
  </struct>

  <struct name="moving_avg">
    <field name="avg"   type="double"/>
    <field name="total" type="double"/>
    <field name="count" type="double"/>
    <field name="start" type="double"/>
  </struct>

  <struct name="pair__int__set">
    <field name="first"  type="int"/>
    <field name="second" type="set"/>
  </struct>

</structs>
