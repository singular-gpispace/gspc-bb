<structs>

  <struct name="running_reduction">
    <field name="i" type="int"/>
    <field name="j" type="int"/>
    <field name="old_r" type="int"/>
	</struct>

  <struct name="index_pair">
    <field name="i" type="int"/>
    <field name="j" type="int"/>
  </struct>

  <struct name="tuple__index_pair__int__set">
    <field name="first" type="index_pair"/>
    <field name="second" type="int"/>
    <field name="third" type="set"/>
  </struct>

</structs>
