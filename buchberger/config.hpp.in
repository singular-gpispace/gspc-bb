#pragma once

#include <filesystem>

namespace config
{
    static std::filesystem::path const installation("@CMAKE_INSTALL_PREFIX@");
    static std::filesystem::path const sing_path("@SINGULAR_HOME@");
    inline std::filesystem::path const& singularLibrary()
    {
        static std::filesystem::path const library
         ( sing_path / "lib" / "libSingular.so"
        );

        return library;
    }
    inline std::filesystem::path const& implementation()
    {
        static std::filesystem::path const library(
         installation / "libexec" / "workflow" / "libbuchberger_implementation.so"
         );
        return library;
  }
}
