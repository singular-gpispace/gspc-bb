//degBound=0; testParallelBB(M,4,4,2,"TEST_M1M2",list(list(degBound,15)));







proc MInew(module M, int r) // M: first module with arbitrary elements, r: number, the second module is assumed to be:  var(1)*gen(1), ... , var(r)*gen(r), gen(r+1), ... ,gen(nvars(basering))
{
  system("--ticks-per-sec", 1000);

  matrix M1_mat = matrix(M);
  matrix M1red_mat[r][ncols(M1_mat)];
  matrix M2red_mat[r][r];
  module M1red,M2red,Mred;
  int i,j;
  for (i=1; i<=r; i++) {
    M2red_mat[i,i] = var(i);
    for(j=1; j<=ncols(M1_mat); j++) {
      //M1red_mat[i,j] = subst(M1_mat[i,j], var(i), 0);
      M1red_mat[i,j] = M1_mat[i,j];
    }
  }

  matrix Mred_mat = concat(M1red_mat,M2red_mat);

  module Mred  = module(Mred_mat);
  module M1red = module(M1red_mat);
  module M2red = module(M2red_mat);
  return(Mred);
/*
  int ttt=rtimer;
  print("S:");
  matrix S = matrix(syz(Mred));
  printf("deg=%s, size=%s, time=%s ms", maxdeg(S), ncols(S), rtimer-ttt);
  print("C:");
  matrix C = submat(S, 1..ncols(M1red), 1..ncols(S));
  printf("deg=%s, size=%s", maxdeg(C), ncols(C));


  return(module(M1_mat*C));
*/
}


