proc timestd(def I, list #)
{
  int tps=1;
  if(size(#)>0) {tps=#[1];}
  system("--ticks-per-sec",tps);
  int t=rtimer;
  def G = std(I);
  printf("time: %s (%s ticks per second)",rtimer-t,tps);
  return(G);
}




