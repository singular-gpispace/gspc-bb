LIB "buchbergergspc.lib";
LIB "random.lib";
LIB "matrix.lib";



option(redSB); // if option redSB is set: gspc_buchberger will calculate a unique reduced basis

gspcConfigToken gc = configure_gspc();

// directory used by GPI-Space to save temporary files (absolute path or else relative to the current directory)
gc.tmpdir = "tempdir";
gc.installdir = "";

gc.nodefile = "nodefile"; // file containing names of the nodes used in the compputation (absolute path or relative to install directory)
gc.procspernode = 8;      // number of cores used per node
gc.deleteoutputfiles = 1; // if true the final output file will also be deleted after reading the result into SINGULAR

// call once if you use gspc-monitor:
proc monitorON()
{
  gc.loghostfile = "loghostfile"; // absolute path or relative to install directory
  gc.logport = 3217;
}// absolute path or relative to install directory

proc getcores()
{
  return(gc.procspernode);
}

proc test_opt(string opt) {
  intvec state = option(get);
  option(opt);
  if(state==option(get)) {
    return (1);
  }
  else {
    option("no"+opt);
    return (0);
  }
}

proc normalize(def container) {
  if (test_opt("intStrategy")) {
    for(int i=1; i<=size(container); i++) {
      container[i] = container[i] / content(container[i]);
    }
    return(container);
  }
  else {
    for(int i=1; i<=size(container); i++) {
      container[i] = container[i] / leadcoef(container[i]);
    }
    return(container);
  }
}


proc leadmonoms(def I)
{
  if (typeof(I)=="ideal") {
    ideal res;
  }
  else {if(typeof(I)=="module") {
    module res;
  }
  else {
    print("ERROR! Input must be ideal or module!");
    return();
  }}

  for(int i=1; i<=size(I); i++) {
    res[i] = leadmonom(I[i]);
  }
  return (res);
}

proc comp(def I, def J) // recursive compare-function for indexed types
{
  string t = typeof(I);
  int i,n;
  if(t!=typeof(J)) {return(0);}
  if(t=="ideal" || t=="list" || t=="intvec" || t=="module")
  {
    n = size(I);
    if(n != size(J)) {return(0);}
    else {
      for(i=1; i<=n; i++)
      {
        if(t=="ideal" || t=="module") {
          if(!comp(I[i],J[i]) && !comp(I[i],-J[i])) {return(0);}
        }
        else {if(!comp(I[i],J[i])) {return(0);}}
      }
      return(1);
    }
  }
  else {return (I==J);}
}

proc parallelStd(def I, list #) // test the parallel implementation of Buchberger's algorithm (gspc_buchberger)
{
  int ncores, nworkers, force_continue;
  if(size(#)>=1) {ncores   = #[1];}
  else           {ncores = getcores();}
  if(size(#)>=2) {nworkers = #[2];}
  else           {nworkers = ncores-1;}
  if(size(#)>=3) {force_continue = #[3];}
  else           {force_continue = 0;}

  gc.procspernode = ncores;
  return(gspc_buchberger(I, gc, nworkers));
}

proc testSTD(def I, list #) // test Singular's implementation of Buchberger's algorithm (std)
{
  system("--ticks-per-sec", 1000);
  int time = rtimer;
  print("std:");
  def G = std(I);
  printf(" took %sms", rtimer-time);
  return(G);
}

proc testParallelBB(def I, int ncores, int nworkers, int force_continue, list #) // test the parallel implementation of Buchberger's algorithm (gspc_buchberger) + display runtimes
{
  int i,j;
  gc.procspernode = ncores;
  def GB;
  module L,S;
  int r_all, target_time, max_batch_size, head_size_factor, syz_comp, red_syz;
  list indices;
  list runtimes;
  list degBounds;
  if (size(#)>1) {degBounds = #[2];}
  else           {degBounds = list(list(degBound,nvars(basering)));}
  if (size(#)>2) {target_time = #[3];}
  else           {target_time = 100;}
  if (size(#)>3) {max_batch_size = #[4];}
  else           {max_batch_size = 50;}
  if (size(#)>4) {head_size_factor = #[5];}
  else           {head_size_factor = 150;}
  if (size(#)>5) {syz_comp = #[6];}
  else           {syz_comp = 0;}
  if (size(#)>6) {red_syz = #[7];}
  else           {red_syz = 1;}
  int auto_syz_comp = 0;
  if(syz_comp==-1) {
    auto_syz_comp = 1;
    module I_in = module(I);
    syz_comp = nrows(I_in);
    for(i=1; i<=size(I_in); i++) {
      I_in[i] = I_in[i] + gen(syz_comp+i);
    }
  }
  else {
    def I_in=I;
  }
  GB, L, S, r_all, indices, runtimes = gspc_buchberger_extraData(I_in, gc, nworkers, degBounds, force_continue, target_time, max_batch_size, head_size_factor, syz_comp, red_syz);
  if (size(#)>0) {write("ssi:w "+gc.tmpdir+"/BUCHBERGER_RESULT_"+#[1]+"_"+string(ncores)+"_cores_"+string(nworkers)+"_NFworkers.ssi",list(I, GB, L, S, r_all, indices, runtimes));}

  if(size(string(I))<2000) {printf("%nI (%s elements): %n%p",size(I),I);}
  else {printf("%nI (%s elements): ...",size(I));}
  if(size(string(GB))<2000) {printf("%nGB (%s elements): %n%p",size(GB),GB);}
  else {printf("%nGB (%s elements): ...",size(GB));}
  printf("%nmax number of elements during the BB algorithm: %s%n",r_all,0);

  bigint irl_time = runtimes[2][1][2]-runtimes[2][1][1];
  print("TIMINGS (in ms):");
  //printf("starttime:                                  %s ms",  runtimes[2][1][1]);
  //printf("stoptime:                                   %s ms",  runtimes[2][1][2]);
  printf("runtime (stoptime - starttime):             %s ms",  irl_time);       bigint runtimes_times_100 = runtimes[2][2][1]*100;
  printf("cputime (added up over parallel processes): %s ms (%s%)", runtimes[2][2][1], runtimes_times_100 div irl_time);
  printf("total number of transitions:                %s %n",       runtimes[2][2][2],0);
  printf("max time of a single transition:            %s ms%n",     runtimes[2][2][3],0);
  int j_max=0;
  for(i=3; i<=size(runtimes[1]); i++) {j_max = max(j_max,size(runtimes[1][i]));}
  string s;
  for(i=3; i<=size(runtimes[1]); i++) {
    for(j=size(runtimes[1][i]); j<=j_max; j++) {runtimes[1][i] = " "+runtimes[1][i];}
    s="";
    if (runtimes[2][i][3]<0 && runtimes[2][i][1]==-1) //count
      {
        for(j=size(string(runtimes[2][i][2])); j<=8; j++) {s = " "+s;}
        printf(runtimes[1][i]+": %s"+s+"     (max: %s)", runtimes[2][i][2], -1-runtimes[2][i][3]);
      }
    else // timing
      {
        for(j=size(string(runtimes[2][i][1])); j<=8; j++) {s = " "+s;}
        printf(runtimes[1][i]+": %s"+s+" ms  (number: %s, max time: %s ms)", runtimes[2][i][1], runtimes[2][i][2], runtimes[2][i][3]);
      }
  }

  if(auto_syz_comp==1) {
    if(size(module((matrix(I)*matrix(S))))==0)       {print("syzygy module CORRECT !!!");}
    else                                             {print("syzygy module WRONG !!!");}
    if(comp(module(GB),module(matrix(I)*matrix(L)))) {print("         lift CORRECT !!!");}
    else                                             {print("         lift WRONG !!!");}
  }

  export(GB,L,S,indices,runtimes);
}

proc testBB(def I, int ncores, int nworkers, int force_continue, list #) // compare both implementations
{
  gc.procspernode = ncores;

  int syz_comp;
  if (size(#)>5) {syz_comp = #[6];}
  else           {syz_comp = 0;}

  print("parallelStd:");
  testParallelBB(I, ncores, nworkers, force_continue, #);

  def G = testSTD(I, #);

  int equ;
  if(syz_comp==0)               {equ = comp(       G ,           GB );}
  else { if(typeof(G)=="ideal") {equ = comp(module(G), normalize(GB));}
  else                          {equ = comp(       G , normalize(GB));} }
  if(equ) {printf("%nEQUAL to std(I) !!!",0);}
  else    {printf("%nNOT equal to std(I) !!!",0);}

  if (size(#)>0) {write("ssi:w "+gc.tmpdir+"/BUCHBERGER_RESULT_"+#[1]+"_"+string(ncores)+"_cores_"+string(nworkers)+"_NFworkers_SINGULAR_std.ssi",list(G, comp(G, GB)));}

  export(G);
}


