number c4 = prime(120);
*/

module m1_original = (-z1 + z4)*gen(1) + (3*c1 + c4 - z1 + 2*z2 + z4 - z6 - z9)*gen(3) + (-z1 + z4)*gen(4) + (4*c1 - z1 + 2*z2 + z4 - z6 - z9)*gen(5) + (c2 - c3 - z1 + z4)*gen(8), (3*c1 + c4 + 2*z2 - z6 - z9)*gen(2) + (3*c1 + c4 - z1 + 2*z2 + z4 - z6 - z9)*gen(3) + (4*c1 - z1 + 2*z2 + z4 - z6 - z9)*gen(5) + (4*c1 + 2*z2 - z6 - z9)*gen(6) + (3*c1 - c2 + c3 + c4 + 2*z2 - z6 - z9)*gen(7) + (2*c1 + 2*c4 + 2*z2 - z6 - z9)*gen(9), (-3*c1 - c3 - z1 - z2 - z3 + z5 + z8 + z9)*gen(1) + (-3*c1 + c2 - c3 - c4 - z1 - z2 - z3 + z5 + z6 - z7 + z8 + z9)*gen(3) + (-2*c1 + c2 - 2*c3 - c4 - z1 - z2 - z3 + z5 + z8 + z9)*gen(4) + (-2*c1 + c2 - 2*c3 - c4 - z1 - z2 - z3 + z5 + z6 - z7 + z8 + z9)*gen(5) + (-4*c1 - z1 - z2 - z3 + z5 + z8 + z9)*gen(8), (c2 - c4 + z6 - z7)*gen(2) + (-3*c1 + c2 - c3 - c4 - z1 - z2 - z3 + z5 + z6 - z7 + z8 + z9)*gen(3) + (-2*c1 + c2 - 2*c3 - c4 - z1 - z2 - z3 + z5 + z6 - z7 + z8 + z9)*gen(5) + (z6 - z7)*gen(6) + (z6 - z7)*gen(7) + (-c1 + c2 + c3 - c4 + z6 - z7)*gen(9), (-c1 - c3 - 2*z1 + z4 + z8)*gen(1) + (c2 - c3 - 2*z1 + z2 + z4 - z7 + z8)*gen(3) + (-c1 + c2 - 2*c3 - 2*z1 + z4 + z8)*gen(4) + (c2 - 2*c3 - c4 - 2*z1 + z2 + z4 - z7 + z8)*gen(5) + (-c1 + c2 - 2*z1 + z4 + z8)*gen(8), (c1 + c2 + z2 - z7)*gen(2) + (c2 - c3 - 2*z1 + z2 + z4 - z7 + z8)*gen(3) + (c2 - 2*c3 - c4 - 2*z1 + z2 + z4 - z7 + z8)*gen(5) + (c1 - c4 + z2 - z7)*gen(6) + (c1 - c2 + z2 - z7)*gen(7) + (c1 + c2 + c3 + c4 + z2 - z7)*gen(9), 2*(c1 + z1)*gen(1) + (z1 - z2 + z3)*gen(3) + (2*c1 + z1 + z4)*gen(4) + (-2*c1 + z1 - 2*z2 + z5 + z9)*gen(5) + (c1 - c3 + z1 + z8)*gen(8), (-2*c1 - z1 - z2 + z3)*gen(2) + (z1 - z2 + z3)*gen(3) + (-2*c1 + z1 - 2*z2 + z5 + z9)*gen(5) + (-4*c1 - 2*z2 - z4 + z5 + z9)*gen(6) + (-c1 + c3 + z1 - z2 + z3 - z4 - z8)*gen(7) + (-z1 + 2*z3 - z5 - z9)*gen(9), (-2*c1 - z1 - z2 + z3)*gen(1) + (-z1 + z2 + z3)*gen(3) + (c1 + c4 - z1 + z2 + z3 - z6 - z9)*gen(4) + (2*c1 - z1 + 2*z2 + z3 - z9)*gen(5) + (-4*c1 + c2 - c4 - z1 - 2*z2 + z3 + z6 - z7 + z9)*gen(8), 2*(c1 + z2)*gen(2) + (-z1 + z2 + z3)*gen(3) + (2*c1 - z1 + 2*z2 + z3 - z9)*gen(5) + (c1 - c4 + z2 + z6)*gen(6) + (c1 - c2 + z2 + z7)*gen(7) + (z2 + z9)*gen(9);

module m2 = z1*gen(1), z2*gen(2), z3*gen(3), z4*gen(4), z5*gen(5), z6*gen(6), z7*gen(7), gen(8), gen(9);

module m1 = module(m1_original[intvec(1,3,5,7,9)]) + module(m1_original[intvec(2,4,6,8,10)]);

matrix m1_mat = matrix(m1);
matrix m1block_mat =                                             submat(m1_mat,1,1..10);
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,4,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,8,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,2,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,6,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,7,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,9,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,3,1..10))));
m1block_mat = transpose(concat(transpose(m1block_mat), transpose(submat(m1_mat,5,1..10))));
module m1block = module(m1block_mat);
module m2block = z1*gen(1), z4*gen(2), gen(3), z2*gen(4), z6*gen(5), z7*gen(6), gen(7), z3*gen(8), z5*gen(9);
module mblock = m1block + m2block;

module m1d = m1;
m1d[1] = m1d[1] + z8^10*gen(10);


module m=m1+m2;

module m_unit       = module(transpose(concat(transpose(matrix(m)),unitmat(size(m)))));
module m_small_unit = m1 + module(transpose(concat(transpose(matrix(m2)),unitmat(size(m2)))));
module m_intersect  = m1 + module(transpose(concat(matrix(m2),matrix(m2))));

module m_sorted = module(m[intvec(18,19,17..7,1,6,5,2,4,3)]);

