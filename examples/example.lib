option(redSB); option(redTail); option(prot); //option(noreturnSB);


int nodes=1;
//list cores_per_node = 32,16,8,4,2,1;
list cores_per_node = 24;

//testParallelBB(G_intersect, cores_per_node[1], cores_per_node[1]*nodes, 2, "testideal_"+string(cores_per_node[1]*nodes)+"_CORES", list(list(degBound,nvars(basering))), 100, 10, 150, nrows(M1), 0); // last 5 arguments: target_time, max_batch_size, head_size_factor, syz_comp, red_syz//!!
gc.procspernode=cores_per_node[1]; 
bc.nworkers=cores_per_node[1]*nodes; 
bc.measureTimings=1;
bc.syzComp=0;
bc.redSyz=0;
printf("%n |||||||||-->  %s CORES  <--||||||||||%n",bc.nworkers,0);
testBB(I, gc, bc, "testideal_"+string(bc.nworkers)+"_CORES"); 
for(int ind=2; ind<=size(cores_per_node); ind++)
{
  gc.procspernode=cores_per_node[ind]; 
  bc.nworkers=cores_per_node[ind]*nodes; 
  printf("%n |||||||||-->  %s CORES  <--||||||||||%n",bc.nworkers,0);
  testParallelBB(I, gc, bc, "testideal_"+string(bc.nworkers)+"_CORES");
}


