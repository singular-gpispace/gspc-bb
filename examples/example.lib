matrix S[48][33] = M_mat,unit_mat;
matrix E[1][15] = e(1),e(2),e(1),e(2),e(1),e(2),e(1),e(2),e(1),e(2),e(1),e(2),e(1),e(2),e(1);

module M1 = module(M1_mat);
module M2 = module(M2_mat);
module M = M1+M2;
module M_intersect  = M1 + module(transpose(concat(matrix(M2),matrix(M2))));
