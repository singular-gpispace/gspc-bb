LIB "buchbergergspc.lib";
LIB "random.lib";
LIB "matrix.lib";
LIB "modstd.lib";





gspcConfigToken gc = configure_gspc();

// directory used by GPI-Space to save temporary files (absolute path or else relative to the current directory)
gc.tmpdir = "tempdir";
gc.installdir = "";

gc.nodefile = "nodefile"; // file containing names of the nodes used in the compputation (absolute path or relative to install directory)
gc.procspernode = 8;      // number of cores used per node

// toggle whether you want to use gspc-monitor:
// (the monitor application must be started before starting the BB algorithm!)
proc monitorON()
{
  gc.loghostfile = "loghostfile"; // absolute path or relative to install directory
  gc.logport = 3217;
}
proc monitorOFF()
{
  gc.loghostfile = ""; // no loghostfile ==> gpi-space will be started without monitor
}


buchbergerConfigToken bc = configure_buchberger();

bc.nworkers=8; // number of reduction steps that can run in parallel, should not be larger than to gc.procspernode * [number of nodes in the nodefile] 
bc.syzComp=0;
bc.redSyz=1;
bc.measureTimings=0;

option(redSB); // if option redSB is set: gspc_buchberger will calculate a unique reduced basis, else just a minimal basis
// Note that other options like redTail and intStrategy also influence the algorithm just like they would with Singular's std(..)



